{
  "name": "go",
  "type": "runtime",
  "platforms": {
    "linux-amd64": {
      "artifact": "go{version}.linux-amd64.tar.gz",
      "format": "tar.gz",
      "strip_components": 1,
      "bin_paths": [
        "bin"
      ]
    },
    "linux-arm64": {
      "artifact": "go{version}.linux-arm64.tar.gz",
      "format": "tar.gz",
      "strip_components": 1,
      "bin_paths": [
        "bin"
      ]
    },
    "darwin-arm64": {
      "artifact": "go{version}.darwin-arm64.tar.gz",
      "format": "tar.gz",
      "strip_components": 1,
      "bin_paths": [
        "bin"
      ]
    }
  },
  "env": {
    "GOROOT": "{install_path}"
  }
}
