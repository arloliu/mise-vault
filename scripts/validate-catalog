#!/usr/bin/env python3
"""Validate the mise-vault catalog: schema conformance plus catalog rules.

Checks every catalog/<tool>/{tool.json,versions.json} against the JSON
Schemas in schemas/ plus cross-file rules the schemas cannot express:

  - tool.json "name" must equal the catalog directory name
  - versions must be unique within a tool
  - every platform in a version record must be declared in tool.json
  - purely numeric version schemes must be in ascending order
    (non-numeric schemes skip the order check; order is still authoritative)
  - artifact templates must be plain file names (no path separators or
    shell metacharacters); bin paths must be relative and free of '..'
  - an artifact-type tool (archive/binary/runtime) must have platform-shaped
    version entries; a go-type tool must have go-shaped version entries
    (a version entry never mixes "platforms" and "h1")
  - a go tool's module must end in the tool name (go install names the
    binary after the module path's last element)
  - a go tool's module_root, when present, must be a prefix of module
    (equal to it, or a parent path of it)

The dep-free built-in checks always run; when the `jsonschema` package is
available (CI), the formal schemas in schemas/ are validated on top of them.

Usage: scripts/validate-catalog [--catalog-dir DIR]
Exit code 0 = valid, 1 = violations found.
"""
import argparse
import json
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLATFORM_RE = re.compile(r"^(linux|darwin|windows)-(amd64|arm64)\Z")
SHA256_RE = re.compile(r"^[0-9a-f]{64}\Z")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*\Z")
VERSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*\Z")
NUMERIC_RE = re.compile(r"^\d+(\.\d+)*\Z")
FORMATS = {"tar.gz", "tar.xz", "tar.bz2", "zip", "binary"}
# An artifact template is a plain file name: no path separators, no shell
# metacharacters. It renders into download commands and file paths.
ARTIFACT_RE = re.compile(r"^[A-Za-z0-9._+{}-]+\Z")
# A bin path is relative, never escapes the install directory, and contains
# no shell metacharacters.
BIN_PATH_RE = re.compile(r"^[A-Za-z0-9._+/-]+\Z")
# A go module path (or module root): lowercase host-looking first segment
# (contains a dot), at least one more path segment, no '..',
# and no dots-only path segment ("." or ".." would change which path
# the module name resolves to).
# Lowercase only:
# uppercase module paths need go-proxy escaping, which nothing here
# implements, so they are refused instead.
# It is inserted into shell commands,
# so the character set is deliberately narrow.
# A path segment may not begin or end with a dot (go refuses those).
MODULE_RE = re.compile(
    r"^[a-z0-9]+(?:[a-z0-9-]*\.[a-z0-9-]+)+(?:/[a-z0-9_~-](?:[a-z0-9._~-]*[a-z0-9_~-])?)+\Z")
# A go tool version is bare (no leading "v"): the plugin prepends the "v"
# when calling go, so a stored "v0.4.0" would render as "vv0.4.0"
# and could never install.
# Lowercase only: the catalog tooling builds proxy URLs from the version
# literally, and an uppercase version would need go-proxy escaping there.
GO_VERSION_RE = re.compile(r"^[0-9][a-z0-9.+_-]*\Z")
H1_RE = re.compile(r"^h1:[A-Za-z0-9+/]{43}=\Z")

errors = []


def err(path, msg):
    errors.append(f"{path}: {msg}")


def load(path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        err(path, f"unreadable or invalid JSON: {e}")
        return None


def jsonschema_validate(instance, schema_file, path):
    """Formal validation when the jsonschema package is present."""
    import jsonschema  # noqa: import guarded by caller

    schema = json.loads((REPO / "schemas" / schema_file).read_text())
    validator = jsonschema.Draft202012Validator(schema)
    for e in validator.iter_errors(instance):
        loc = "/".join(str(p) for p in e.absolute_path) or "<root>"
        err(path, f"schema: {loc}: {e.message}")


def builtin_validate_go_tool(tool, path):
    for key in ("name", "type", "module"):
        if key not in tool:
            err(path, f"missing required field '{key}'")
    unknown = set(tool) - {"name", "type", "module", "module_root", "env"}
    if unknown:
        err(path, f"unknown fields: {sorted(unknown)}")
    if "name" in tool and not NAME_RE.match(str(tool["name"])):
        err(path, f"invalid name: {tool['name']!r}")
    module = tool.get("module")
    if "module" in tool:
        if not isinstance(module, str) or not MODULE_RE.match(module) or ".." in module:
            err(path, f"invalid module: {module!r} (expected a package path like "
                      f"host.example/org/repo/cmd/tool)")
        elif "name" in tool and module.rstrip("/").rsplit("/", 1)[-1] != tool["name"]:
            err(path, f"module {module!r} does not end in the tool name "
                      f"{tool['name']!r} (go install names the binary after the "
                      f"module path's last element)")
    root = tool.get("module_root")
    if "module_root" in tool:
        if not isinstance(root, str) or not MODULE_RE.match(root) or ".." in root:
            err(path, f"invalid module_root: {root!r}")
        elif isinstance(module, str) and root != module and not module.startswith(root + "/"):
            err(path, f"module_root {root!r} is not a prefix of module {module!r}")
    env = tool.get("env", {})
    if not isinstance(env, dict) or not all(isinstance(v, str) for v in env.values()):
        err(path, "env must be an object of string values")


def builtin_validate_tool(tool, path):
    if not isinstance(tool, dict):
        return err(path, "must be a JSON object")
    if tool.get("type") == "go":
        return builtin_validate_go_tool(tool, path)
    for key in ("name", "type", "platforms"):
        if key not in tool:
            err(path, f"missing required field '{key}'")
    unknown = set(tool) - {"name", "type", "platforms", "env"}
    if unknown:
        err(path, f"unknown fields: {sorted(unknown)}")
    if "name" in tool and not NAME_RE.match(str(tool["name"])):
        err(path, f"invalid name: {tool['name']!r}")
    if "type" in tool and tool["type"] not in {"archive", "binary", "runtime"}:
        err(path, f"invalid type: {tool['type']!r}")
    for plat, pconf in (tool.get("platforms") or {}).items():
        if not PLATFORM_RE.match(plat):
            err(path, f"invalid platform key: {plat!r}")
            continue
        for key in ("artifact", "format"):
            if key not in pconf:
                err(path, f"{plat}: missing '{key}'")
        unknown = set(pconf) - {"artifact", "format", "strip_components", "bin_paths"}
        if unknown:
            err(path, f"{plat}: unknown fields: {sorted(unknown)}")
        if "artifact" in pconf:
            a = str(pconf["artifact"])
            if "{version}" not in a:
                err(path, f"{plat}: artifact template must contain {{version}}")
            if not ARTIFACT_RE.match(a):
                err(path, f"{plat}: artifact must be a plain file name "
                          f"(letters, digits, . _ + - and {{version}} only): {a!r}")
        if "format" in pconf and pconf["format"] not in FORMATS:
            err(path, f"{plat}: invalid format: {pconf['format']!r}")
        sc = pconf.get("strip_components", 0)
        if not isinstance(sc, int) or not 0 <= sc <= 3:
            err(path, f"{plat}: strip_components out of range: {sc!r}")
        bp = pconf.get("bin_paths", ["."])
        if not isinstance(bp, list) or not bp or not all(isinstance(b, str) and b for b in bp):
            err(path, f"{plat}: bin_paths must be a non-empty list of strings")
        else:
            for b in bp:
                if b.startswith("/") or ".." in b or not BIN_PATH_RE.match(b):
                    err(path, f"{plat}: bin path must be relative, must not contain '..', "
                              f"and may use only letters, digits, . _ + - /: {b!r}")
    env = tool.get("env", {})
    if not isinstance(env, dict) or not all(isinstance(v, str) for v in env.values()):
        err(path, "env must be an object of string values")


def builtin_validate_go_version_rec(rec, where, path):
    unknown = set(rec) - {"version", "h1"}
    if unknown:
        err(path, f"{where}: unknown fields: {sorted(unknown)}")
    v = rec.get("version")
    if not isinstance(v, str) or not GO_VERSION_RE.match(v):
        err(path, f"{where}: invalid go tool version: {v!r} "
                  f"(bare version starting with a digit; the plugin prepends the 'v')")
    if "h1" in rec:
        h1 = rec.get("h1")
        if not isinstance(h1, str) or not H1_RE.match(h1):
            err(path, f"{where}: invalid h1: {h1!r} (expected h1:<43 base64 chars>=)")


def builtin_validate_versions(versions, path, tool_type=None):
    if not isinstance(versions, list):
        return err(path, "must be a JSON ARRAY (ordered, oldest-approved first)")
    is_go = tool_type == "go"
    for i, rec in enumerate(versions):
        where = f"[{i}]"
        if not isinstance(rec, dict):
            err(path, f"{where}: must be an object")
            continue
        if is_go:
            builtin_validate_go_version_rec(rec, where, path)
            continue
        unknown = set(rec) - {"version", "platforms"}
        if unknown:
            err(path, f"{where}: unknown fields: {sorted(unknown)}")
        v = rec.get("version")
        if not isinstance(v, str) or not VERSION_RE.match(v):
            err(path, f"{where}: invalid version: {v!r}")
        plats = rec.get("platforms")
        if not isinstance(plats, dict) or not plats:
            err(path, f"{where}: platforms must be a non-empty object")
            continue
        for plat, pdata in plats.items():
            if not PLATFORM_RE.match(plat):
                err(path, f"{where}: invalid platform key: {plat!r}")
            sha = (pdata or {}).get("sha256", "")
            if not SHA256_RE.match(str(sha)):
                err(path, f"{where}/{plat}: invalid sha256: {sha!r}")
            unknown = set(pdata or {}) - {"sha256"}
            if unknown:
                err(path, f"{where}/{plat}: unknown fields: {sorted(unknown)}")


def numeric_key(v):
    return [int(x) for x in v.split(".")]


def cross_checks(tool_dir, tool, versions):
    tpath = tool_dir / "tool.json"
    vpath = tool_dir / "versions.json"
    if tool.get("name") != tool_dir.name:
        err(tpath, f"name {tool.get('name')!r} != directory name {tool_dir.name!r}")
    declared = set(tool.get("platforms") or {})
    seen = set()
    vlist = [r.get("version") for r in versions if isinstance(r, dict)]
    for i, rec in enumerate(r for r in versions if isinstance(r, dict)):
        v = rec.get("version")
        if v in seen:
            err(vpath, f"duplicate version: {v!r}")
        seen.add(v)
        extra = set(rec.get("platforms") or {}) - declared
        if extra:
            err(vpath, f"[{i}] {v}: platforms not declared in tool.json: {sorted(extra)}")
    # order check only for purely numeric schemes; other schemes keep authoring order
    numeric = [v for v in vlist if isinstance(v, str) and NUMERIC_RE.match(v)]
    if len(numeric) == len(vlist) and vlist:
        if [numeric_key(v) for v in vlist] != sorted(numeric_key(v) for v in vlist):
            err(vpath, f"numeric versions not in ascending order: {vlist}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--catalog-dir", default=str(REPO / "catalog"))
    ap.add_argument("--engine", choices=["both", "builtin", "schema"], default="both",
                    help="both (default): built-in checks plus the formal schemas when "
                         "the jsonschema package is available; builtin: built-in checks "
                         "only; schema: formal schemas ONLY (no built-in, no cross-file "
                         "rules) — used by the test suite to prove the schemas reject "
                         "unsafe shapes on their own")
    args = ap.parse_args()
    catalog = Path(args.catalog_dir)
    if not catalog.is_dir():
        print(f"error: no such catalog dir: {catalog}", file=sys.stderr)
        return 1

    try:
        import jsonschema  # noqa: F401
        have_jsonschema = True
    except ImportError:
        have_jsonschema = False
    if args.engine == "schema" and not have_jsonschema:
        print("error: --engine schema requires the jsonschema package", file=sys.stderr)
        return 1
    use_builtin = args.engine in ("both", "builtin")
    use_schema = args.engine in ("both", "schema") and have_jsonschema

    tool_dirs = sorted(p for p in catalog.iterdir() if p.is_dir())
    if not tool_dirs:
        print(f"error: empty catalog: {catalog}", file=sys.stderr)
        return 1

    for tool_dir in tool_dirs:
        tool = load(tool_dir / "tool.json")
        versions = load(tool_dir / "versions.json")
        if tool is None or versions is None:
            continue
        # Default engine "both": the built-in checks always run and the formal
        # schemas run on top when available, so the two rule sets cannot drift
        # apart unnoticed. Engine "schema" isolates the schemas (no built-in,
        # no cross-file rules) so the test suite can prove them independently.
        if use_builtin:
            builtin_validate_tool(tool, tool_dir / "tool.json")
            tool_type = tool.get("type") if isinstance(tool, dict) else None
            builtin_validate_versions(versions, tool_dir / "versions.json", tool_type=tool_type)
        if use_schema:
            jsonschema_validate(tool, "tool.schema.json", tool_dir / "tool.json")
            jsonschema_validate(versions, "versions.schema.json", tool_dir / "versions.json")
        if args.engine != "schema" and isinstance(tool, dict) and isinstance(versions, list):
            cross_checks(tool_dir, tool, versions)

    if args.engine == "schema":
        engine = "jsonschema only"
    elif use_schema:
        engine = "built-in + jsonschema"
    else:
        engine = "built-in checks"
    if errors:
        print(f"validate-catalog: {len(errors)} violation(s) [{engine}]:", file=sys.stderr)
        for e in errors:
            print(f"  {e}", file=sys.stderr)
        return 1
    print(f"validate-catalog: OK — {len(tool_dirs)} tool(s) valid [{engine}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
