#!/usr/bin/env python3
"""Validate the mise-vault catalog: schema conformance plus catalog rules.

Checks every catalog/<tool>/{tool.json,versions.json} against the JSON
Schemas in schemas/ plus cross-file rules the schemas cannot express:

  - tool.json "name" must equal the catalog directory name
  - versions must be unique within a tool
  - every platform in a version record must be declared in tool.json
  - purely numeric version schemes must be in ascending order
    (non-numeric schemes skip the order check; order is still authoritative)

Uses the `jsonschema` package when available (CI); otherwise falls back to
built-in structural checks implementing the same rules (dep-free local runs).

Usage: scripts/validate-catalog [--catalog-dir DIR]
Exit code 0 = valid, 1 = violations found.
"""
import argparse
import json
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLATFORM_RE = re.compile(r"^(linux|darwin|windows)-(amd64|arm64)$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
VERSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*$")
NUMERIC_RE = re.compile(r"^\d+(\.\d+)*$")
FORMATS = {"tar.gz", "tar.xz", "tar.bz2", "zip", "binary"}

errors = []


def err(path, msg):
    errors.append(f"{path}: {msg}")


def load(path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        err(path, f"unreadable or invalid JSON: {e}")
        return None


def jsonschema_validate(instance, schema_file, path):
    """Formal validation when the jsonschema package is present."""
    import jsonschema  # noqa: import guarded by caller

    schema = json.loads((REPO / "schemas" / schema_file).read_text())
    validator = jsonschema.Draft202012Validator(schema)
    for e in validator.iter_errors(instance):
        loc = "/".join(str(p) for p in e.absolute_path) or "<root>"
        err(path, f"schema: {loc}: {e.message}")


def builtin_validate_tool(tool, path):
    if not isinstance(tool, dict):
        return err(path, "must be a JSON object")
    for key in ("name", "type", "platforms"):
        if key not in tool:
            err(path, f"missing required field '{key}'")
    unknown = set(tool) - {"name", "type", "platforms", "env"}
    if unknown:
        err(path, f"unknown fields: {sorted(unknown)}")
    if "name" in tool and not NAME_RE.match(str(tool["name"])):
        err(path, f"invalid name: {tool['name']!r}")
    if "type" in tool and tool["type"] not in {"archive", "binary", "runtime"}:
        err(path, f"invalid type: {tool['type']!r}")
    for plat, pconf in (tool.get("platforms") or {}).items():
        if not PLATFORM_RE.match(plat):
            err(path, f"invalid platform key: {plat!r}")
            continue
        for key in ("artifact", "format"):
            if key not in pconf:
                err(path, f"{plat}: missing '{key}'")
        unknown = set(pconf) - {"artifact", "format", "strip_components", "bin_paths"}
        if unknown:
            err(path, f"{plat}: unknown fields: {sorted(unknown)}")
        if "artifact" in pconf and "{version}" not in pconf["artifact"]:
            err(path, f"{plat}: artifact template must contain {{version}}")
        if "format" in pconf and pconf["format"] not in FORMATS:
            err(path, f"{plat}: invalid format: {pconf['format']!r}")
        sc = pconf.get("strip_components", 0)
        if not isinstance(sc, int) or not 0 <= sc <= 3:
            err(path, f"{plat}: strip_components out of range: {sc!r}")
        bp = pconf.get("bin_paths", ["."])
        if not isinstance(bp, list) or not bp or not all(isinstance(b, str) and b for b in bp):
            err(path, f"{plat}: bin_paths must be a non-empty list of strings")
    env = tool.get("env", {})
    if not isinstance(env, dict) or not all(isinstance(v, str) for v in env.values()):
        err(path, "env must be an object of string values")


def builtin_validate_versions(versions, path):
    if not isinstance(versions, list):
        return err(path, "must be a JSON ARRAY (ordered, oldest-approved first)")
    for i, rec in enumerate(versions):
        where = f"[{i}]"
        if not isinstance(rec, dict):
            err(path, f"{where}: must be an object")
            continue
        unknown = set(rec) - {"version", "platforms"}
        if unknown:
            err(path, f"{where}: unknown fields: {sorted(unknown)}")
        v = rec.get("version")
        if not isinstance(v, str) or not VERSION_RE.match(v):
            err(path, f"{where}: invalid version: {v!r}")
        plats = rec.get("platforms")
        if not isinstance(plats, dict) or not plats:
            err(path, f"{where}: platforms must be a non-empty object")
            continue
        for plat, pdata in plats.items():
            if not PLATFORM_RE.match(plat):
                err(path, f"{where}: invalid platform key: {plat!r}")
            sha = (pdata or {}).get("sha256", "")
            if not SHA256_RE.match(str(sha)):
                err(path, f"{where}/{plat}: invalid sha256: {sha!r}")
            unknown = set(pdata or {}) - {"sha256"}
            if unknown:
                err(path, f"{where}/{plat}: unknown fields: {sorted(unknown)}")


def numeric_key(v):
    return [int(x) for x in v.split(".")]


def cross_checks(tool_dir, tool, versions):
    tpath = tool_dir / "tool.json"
    vpath = tool_dir / "versions.json"
    if tool.get("name") != tool_dir.name:
        err(tpath, f"name {tool.get('name')!r} != directory name {tool_dir.name!r}")
    declared = set(tool.get("platforms") or {})
    seen = set()
    vlist = [r.get("version") for r in versions if isinstance(r, dict)]
    for i, rec in enumerate(r for r in versions if isinstance(r, dict)):
        v = rec.get("version")
        if v in seen:
            err(vpath, f"duplicate version: {v!r}")
        seen.add(v)
        extra = set(rec.get("platforms") or {}) - declared
        if extra:
            err(vpath, f"[{i}] {v}: platforms not declared in tool.json: {sorted(extra)}")
    # order check only for purely numeric schemes; other schemes keep authoring order
    numeric = [v for v in vlist if isinstance(v, str) and NUMERIC_RE.match(v)]
    if len(numeric) == len(vlist) and vlist:
        if [numeric_key(v) for v in vlist] != sorted(numeric_key(v) for v in vlist):
            err(vpath, f"numeric versions not in ascending order: {vlist}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--catalog-dir", default=str(REPO / "catalog"))
    args = ap.parse_args()
    catalog = Path(args.catalog_dir)
    if not catalog.is_dir():
        print(f"error: no such catalog dir: {catalog}", file=sys.stderr)
        return 1

    try:
        import jsonschema  # noqa: F401
        have_jsonschema = True
    except ImportError:
        have_jsonschema = False

    tool_dirs = sorted(p for p in catalog.iterdir() if p.is_dir())
    if not tool_dirs:
        print(f"error: empty catalog: {catalog}", file=sys.stderr)
        return 1

    for tool_dir in tool_dirs:
        tool = load(tool_dir / "tool.json")
        versions = load(tool_dir / "versions.json")
        if tool is None or versions is None:
            continue
        if have_jsonschema:
            jsonschema_validate(tool, "tool.schema.json", tool_dir / "tool.json")
            jsonschema_validate(versions, "versions.schema.json", tool_dir / "versions.json")
        else:
            builtin_validate_tool(tool, tool_dir / "tool.json")
            builtin_validate_versions(versions, tool_dir / "versions.json")
        if isinstance(tool, dict) and isinstance(versions, list):
            cross_checks(tool_dir, tool, versions)

    engine = "jsonschema" if have_jsonschema else "built-in checks"
    if errors:
        print(f"validate-catalog: {len(errors)} violation(s) [{engine}]:", file=sys.stderr)
        for e in errors:
            print(f"  {e}", file=sys.stderr)
        return 1
    print(f"validate-catalog: OK — {len(tool_dirs)} tool(s) valid [{engine}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
