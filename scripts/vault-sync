#!/usr/bin/env bash
# vault-sync — regenerate the machine's mise-vault config from the plugin catalog.
#
# Generates ~/.config/mise/conf.d/mise-vault.toml containing:
#   - [tool_alias] <tool> = "vault:<tool>[nexus_url=...]"  for every catalog tool
#   - [tasks.vault-sync] so `mise run vault-sync` re-runs this script
#
# With a ref argument, first re-pins the plugin to that release, then
# regenerates from the NEW checkout:
#   vault-sync            # regenerate only
#   vault-sync v1.2.0     # update plugin to v1.2.0, then regenerate
#
# The generated file is derived data: never hand-edit it.
set -euo pipefail

PLUGIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_NAME=vault
CONF_DIR="${MISE_CONFIG_DIR:-$HOME/.config/mise}/conf.d"
CONF_FILE="$CONF_DIR/mise-vault.toml"

# --- optional: update the plugin to a new release first ---------------------
REF="${1:-}"
if [ -n "$REF" ]; then
    URL=$(git -C "$PLUGIN_DIR" remote get-url origin)
    echo "vault-sync: updating plugin to $REF ..."
    mise plugin install -f "$PLUGIN_NAME" "$URL#$REF"
    # the checkout has been replaced — hand over to the new script version
    exec "$PLUGIN_DIR/scripts/vault-sync"
fi

# --- read defaults from the plugin checkout ---------------------------------
NEXUS_URL=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['nexus_url'])" \
    "$PLUGIN_DIR/config/defaults.json")

TOOLS=$(cd "$PLUGIN_DIR/catalog" && ls -1d */ | tr -d /)
[ -n "$TOOLS" ] || { echo "vault-sync: empty catalog in $PLUGIN_DIR" >&2; exit 1; }

# --- generate ---------------------------------------------------------------
mkdir -p "$CONF_DIR"
TMP=$(mktemp)
{
    echo "# GENERATED by mise-vault vault-sync — do not edit."
    echo "# Regenerate with: mise run vault-sync   (or scripts/vault-sync in the plugin checkout)"
    echo "# Plugin: $PLUGIN_DIR"
    echo
    echo "[tool_alias]"
    for tool in $TOOLS; do
        echo "$tool = 'vault:$tool[nexus_url=$NEXUS_URL]'"
    done
    echo
    echo "[tasks.vault-sync]"
    echo "description = 'Update the mise-vault plugin and regenerate this config'"
    echo "run = 'bash $PLUGIN_DIR/scripts/vault-sync'"
} > "$TMP"
mv "$TMP" "$CONF_FILE"

echo "vault-sync: wrote $CONF_FILE"
echo "vault-sync: tools: $(echo $TOOLS | tr '\n' ' ')"
