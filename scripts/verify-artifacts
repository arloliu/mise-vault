#!/usr/bin/env python3
"""Verify every catalog entry against Nexus.

For each catalog/<tool>/versions.json record and platform:
  - HEAD the artifact URL — a missing artifact fails the run
  - with --checksum: download and compare SHA-256 to the catalog value

Auth: curl -n (~/.netrc) plus $NEXUS_CURL_OPTS, same convention as add-version.

Usage:
  scripts/verify-artifacts [--checksum] [--tool T ...]
                           [--nexus-url URL] [--catalog-dir DIR]
Exit code 0 = all verified, 1 = any failure.
"""
import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def curl(args, text=True):
    import os

    extra = os.environ.get("NEXUS_CURL_OPTS", "").split()
    return subprocess.run(
        ["curl", "-fsSL", "-n", "--retry", "2", *extra, *args],
        capture_output=True, text=text,
    )


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checksum", action="store_true", help="download and verify sha256")
    ap.add_argument("--tool", action="append", help="restrict to these tools")
    ap.add_argument("--nexus-url")
    ap.add_argument("--catalog-dir", default=str(REPO / "catalog"))
    args = ap.parse_args()

    nexus = args.nexus_url
    if not nexus:
        defaults = REPO / "config" / "defaults.json"
        nexus = json.loads(defaults.read_text()).get("nexus_url") if defaults.exists() else None
    if not nexus:
        sys.exit("error: no Nexus URL (pass --nexus-url or set config/defaults.json)")

    failures = 0
    checked = 0
    catalog = Path(args.catalog_dir)
    for tool_dir in sorted(p for p in catalog.iterdir() if p.is_dir()):
        tool_name = tool_dir.name
        if args.tool and tool_name not in args.tool:
            continue
        tool = json.loads((tool_dir / "tool.json").read_text())
        versions = json.loads((tool_dir / "versions.json").read_text())
        for rec in versions:
            for plat, pdata in rec["platforms"].items():
                artifact = tool["platforms"][plat]["artifact"].replace("{version}", rec["version"])
                url = f"{nexus}/{tool_name}/{rec['version']}/{artifact}"
                checked += 1
                if curl(["-I", "-o", "/dev/null", url]).returncode != 0:
                    print(f"FAIL missing: {url}")
                    failures += 1
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} {plat}")
                    continue
                with tempfile.NamedTemporaryFile() as tmp:
                    if curl(["-o", tmp.name, url], text=False).returncode != 0:
                        print(f"FAIL download: {url}")
                        failures += 1
                        continue
                    h = hashlib.sha256()
                    with open(tmp.name, "rb") as fh:
                        for chunk in iter(lambda: fh.read(1 << 20), b""):
                            h.update(chunk)
                    if h.hexdigest() != pdata["sha256"]:
                        print(f"FAIL sha256 mismatch: {tool_name} {rec['version']} {plat} "
                              f"(catalog {pdata['sha256']}, got {h.hexdigest()})")
                        failures += 1
                    else:
                        print(f"ok   sha256:  {tool_name} {rec['version']} {plat}")

    mode = "existence+checksum" if args.checksum else "existence"
    if failures:
        print(f"verify-artifacts: {failures}/{checked} FAILED [{mode}]", file=sys.stderr)
        return 1
    print(f"verify-artifacts: OK — {checked} artifact(s) verified [{mode}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
