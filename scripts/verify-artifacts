#!/usr/bin/env python3
"""Verify every catalog entry against its backing store.

For each catalog/<tool>/versions.json record:
  artifact tools (archive/binary/runtime), for each platform:
    - HEAD the artifact URL in Nexus — a missing artifact fails the run
    - with --checksum: download and compare SHA-256 to the catalog value
  go tools:
    - GET the version's .info file at the go proxy — missing fails the run
    - with --checksum, only when the record carries an h1: run
      "go mod download -json" against the same proxy and compare Sum.
      A go tool version with no h1 is a deliberate proxy-trust entry
      (see catalog/<tool>/versions.json); it is reported, not failed.
  npm tools:
    - GET the package document at the npm registry and confirm its
      "versions" map contains the version — missing fails the run.
      With --checksum there is nothing to compare (npm records carry no
      checksum); reported as a skip, same as an h1-less go record.
  pypi tools:
    - GET the PyPI simple API page (PEP 691 JSON, HTML fallback) and
      confirm the version is listed — missing fails the run.
      With --checksum: a record carrying "hashes" is compared against the
      sha256 digests of every release file of that version, read from the
      very same index page (PEP 691 files[].hashes.sha256, or the HTML
      fallback's "#sha256=<hex>" link fragment). The comparison is full
      set equality, so a wrong, drifted, or missing digest on either side
      fails the run — and a hashed record checked against an index that
      exposes no digest at all for its files fails too, since an
      unverifiable hash is never treated as a pass. A record with no
      "hashes" field has nothing to compare and is reported as a skip,
      the same as an h1-less go record or any npm/cargo record (neither
      of those ecosystems ever carries a checksum).
  cargo tools:
    - GET the crate's index file at the registry's documented path and
      confirm a non-yanked line for the version is present — missing
      (or yanked-only) fails the run.
      With --checksum there is nothing to compare either; reported as a
      skip, same as an h1-less go record.

Auth: curl -n (~/.netrc) plus $NEXUS_CURL_OPTS, same convention as add-version.
The go proxy fetch is unauthenticated GET, same as any go-proxy client.
The npm/pypi/cargo probes run through the user's environment too (curl
honors http_proxy; auth rides the same -n/NEXUS_CURL_OPTS convention).

Usage:
  scripts/verify-artifacts [--checksum] [--tool T ...]
                           [--nexus-url URL] [--goproxy-url URL]
                           [--npm-registry-url URL] [--pypi-index-url URL]
                           [--cargo-index-url URL]
                           [--catalog-dir DIR]
Exit code 0 = all verified, 1 = any failure.
"""
import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
H1_RE = re.compile(r"^h1:[A-Za-z0-9+/]{43}=\Z")
# The pypi artifact-hash counterpart to H1_RE above: a bare lowercase-hex
# sha256, checked before any digest collected from the index is compared
# against the catalog's recorded hashes.
HASH_RE = re.compile(r"^[0-9a-f]{64}\Z")
# Base URLs get the same shape check the plugin applies at install time,
# so this gate can never pass a URL the runtime would refuse. Checked
# against the registry/index BASE only, never a composed per-package URL —
# a scoped npm package's "@" is outside this character class on purpose.
URL_RE = re.compile(r"^https?://[A-Za-z0-9._~:/%+-]+\Z")


def curl(args, text=True, follow=False):
    import os

    # --max-redirs 0: a redirect could send the request to a host other than
    # the configured Nexus, so any redirect fails the transfer. -L is kept
    # deliberately: without it a redirect response would count as success
    # (curl -f only fails on 4xx/5xx); with -L plus a zero limit, any
    # redirect becomes a hard curl error instead.
    # The confinement flags come AFTER $NEXUS_CURL_OPTS so a caller-supplied
    # option can never weaken them.
    extra = os.environ.get("NEXUS_CURL_OPTS", "").split()
    base = ["curl", "-sS", "-n", "--retry", "2", *extra, "--max-redirs", "0"]
    if follow:
        base += ["-fL"]
    return subprocess.run(
        [*base, *args],
        capture_output=True, text=text,
    )


def probe(url):
    """HEAD the URL and classify the outcome; None means the artifact exists."""
    r = curl(["-I", "-o", "/dev/null", "-w", "%{http_code}", url])
    if r.returncode != 0:
        return f"unreachable (curl exit {r.returncode})"
    code = (r.stdout or "").strip()[-3:]
    if code == "200":
        return None
    if code in ("401", "403"):
        return f"authentication failed (HTTP {code}) — check ~/.netrc or NEXUS_CURL_OPTS"
    if code == "404":
        return "not found in Nexus (HTTP 404)"
    if code.startswith("3"):
        return f"server redirected (HTTP {code}) — redirects are refused"
    return f"unexpected HTTP {code}"


def escape_module_path(path):
    """Go's module-proxy escaping: uppercase letters become '!' + lowercase.
    Our catalog enforces lowercase module paths, so this is normally a
    no-op — kept so a fetch is spec-correct regardless."""
    return "".join("!" + c.lower() if c.isupper() else c for c in path)


def probe_go_version(proxy, module_root, version):
    """GET the proxy's .info file for this version; None means it exists.

    A plain GET, not HEAD: go's own proxy client only ever uses GET, so a
    compliant proxy may reject HEAD (405) while serving the version fine.
    404 and 410 both mean "this module@version does not exist" per the
    go-proxy protocol."""
    url = f"{proxy}/{escape_module_path(module_root)}/@v/v{version}.info"
    r = curl(["-o", "/dev/null", "-w", "%{http_code}", url])
    if r.returncode != 0:
        return f"unreachable (curl exit {r.returncode})", url
    code = (r.stdout or "").strip()[-3:]
    if code == "200":
        return None, url
    if code in ("404", "410"):
        return f"not found at the go proxy (HTTP {code})", url
    if code.startswith("3"):
        return f"server redirected (HTTP {code}) — redirects are refused", url
    return f"unexpected HTTP {code}", url


def go_mod_sum(proxy, module_root, version):
    """Run "go mod download -json" against the proxy; return (sum, None) or
    (None, reason). Missing go toolchain is a specific reason, not a crash."""
    import os

    if shutil.which("go") is None:
        return None, "no go toolchain on PATH"
    env = dict(os.environ)
    # GONOPROXY/GOPRIVATE are pinned too: a developer GOPRIVATE setting
    # (which doubles as the GONOPROXY default) would otherwise make a
    # matching module bypass the proxy and fetch from version control.
    # A fresh module cache per run: go trusts cached module content without
    # refetching or rehashing it, so an inherited cache could report the
    # expected checksum for tampered content. GOENV=off keeps "go env -w"
    # settings out too.
    with tempfile.TemporaryDirectory() as scratch:
        env.update({"GOPROXY": proxy, "GONOPROXY": "none", "GOPRIVATE": "",
                    "GOSUMDB": "off", "GOTOOLCHAIN": "local", "GOENV": "off",
                    "GOMODCACHE": f"{scratch}/gomodcache", "GOPATH": f"{scratch}/gopath",
                    "GOCACHE": f"{scratch}/gocache", "GOCACHEPROG": "",
                    "GOFLAGS": "-mod=mod -modcacherw"})
        try:
            p = subprocess.run(
                ["go", "mod", "download", "-json", f"{module_root}@v{version}"],
                capture_output=True, text=True, env=env, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, f"go mod download could not run: {e}"
    try:
        decoded = json.loads(p.stdout)
    except json.JSONDecodeError:
        detail = (p.stderr or p.stdout or "").strip().splitlines()
        return None, detail[0] if detail else f"go mod download exited {p.returncode}"
    if decoded.get("Error"):
        return None, decoded["Error"]
    sum_ = decoded.get("Sum")
    if not sum_ or not H1_RE.match(sum_):
        return None, f"go mod download returned no usable Sum: {decoded!r}"
    return sum_, None


def npm_config_get(key):
    """Same convention as scripts/add-version: run "npm config get <key>";
    return the value or None (unset/missing npm/error). npm prints the
    literal word "undefined" for an unset key."""
    if shutil.which("npm") is None:
        return None
    try:
        p = subprocess.run(["npm", "config", "get", key],
                            capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    val = p.stdout.strip()
    if not val or val.lower() == "undefined":
        return None
    return val


def npm_registry_url(package, override):
    """Explicit --npm-registry-url wins outright, matching add-version's
    precedence for --nexus-url/--goproxy-url."""
    if override:
        return override, "explicit --npm-registry-url"
    if package.startswith("@") and "/" in package:
        scope = package.split("/", 1)[0]
        val = npm_config_get(f"{scope}:registry")
        if val:
            return val, f"npm config get {scope}:registry"
    val = npm_config_get("registry")
    if val:
        return val, "npm config get registry"
    return None, None


def npm_escape_package(package):
    if package.startswith("@") and "/" in package:
        scope, name = package.split("/", 1)
        return f"{scope}%2F{name}"
    return package


def probe_npm_version(registry, package, version):
    """GET the package document and check its "versions" map; None means
    the version exists. A 200 with no usable "versions" map is its own
    reason, distinct from "version not listed" — never read a malformed
    response as proof of absence."""
    url = f"{registry.rstrip('/')}/{npm_escape_package(package)}"
    r = curl(["-w", "\n%{http_code}", url])
    if r.returncode != 0:
        return f"unreachable (curl exit {r.returncode})", url
    body, _, code = (r.stdout or "").rpartition("\n")
    if code in ("404", "410"):
        return f"package not found at the npm registry (HTTP {code})", url
    if code.startswith("3"):
        return f"server redirected (HTTP {code}) — redirects are refused", url
    if code != "200":
        return f"unexpected HTTP {code}", url
    try:
        doc = json.loads(body)
    except json.JSONDecodeError:
        return "npm registry response was not valid JSON", url
    versions_map = doc.get("versions")
    if not isinstance(versions_map, dict):
        return "npm registry response has no usable \"versions\" map", url
    if version in versions_map:
        return None, url
    return "version not listed in the npm registry package document", url


def pip_config_get(key):
    """Same convention as scripts/add-version: try "pip config get <key>"
    then "pip3 config get <key>"; return the value or None. Tolerates
    either binary being absent."""
    for binary in ("pip", "pip3"):
        if shutil.which(binary) is None:
            continue
        try:
            p = subprocess.run([binary, "config", "get", key],
                                capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if p.returncode == 0:
            val = p.stdout.strip()
            if val:
                return val
    return None


def pip_index_url(override):
    if override:
        return override, "explicit --pypi-index-url"
    val = pip_config_get("global.index-url")
    if val:
        return val, "pip config get global.index-url"
    return None, None


# The sdist suffix list is the single source of truth for which archive
# forms the matchers below can judge; the recognized-extension tuple is
# derived from it so classification and matching can never disagree.
# .egg is deliberately unsupported (an obsolete format): a version
# published only as an egg is reported as an unreadable file list, never
# as a false absence.
PYPI_SDIST_SUFFIXES = (".tar.gz", ".tgz", ".zip", ".tar.bz2", ".tar.xz")
PYPI_FILENAME_EXTENSIONS = PYPI_SDIST_SUFFIXES + (".whl",)


def pep503_normalize_underscored(name):
    """The PEP 625/wheel form of PEP 503 normalization: lowercase, runs of
    -._ collapsed to a single underscore instead of a hyphen."""
    return re.sub(r"[-_.]+", "_", name).lower()


def pypi_expected_sdist_stems(package, version):
    """The filename stems (extension already stripped) a valid sdist for
    the known package name and known target version is allowed to use:
    the modern PEP 625 form (hyphens replaced by underscores), the legacy
    form (the raw project name as given), and the fully
    PEP 503-normalized-with-underscores form. Matched case-insensitively
    by the caller."""
    return {
        f"{package.replace('-', '_')}-{version}".lower(),
        f"{package}-{version}".lower(),
        f"{pep503_normalize_underscored(package)}-{version}".lower(),
    }


def pypi_filename_matches_sdist(filename, package, version):
    """True if filename is a sdist archive for the known package name and
    known target version. Matches against filenames constructed from that
    name and version rather than token-splitting the filename itself —
    splitting on every hyphen misreads a hyphenated project name like
    "sample-pkg" (the file "sample-pkg-1.2.3.tar.gz" would misparse "pkg"
    as the version)."""
    lower = filename.lower()
    for suffix in PYPI_SDIST_SUFFIXES:
        if lower.endswith(suffix):
            return lower[: -len(suffix)] in pypi_expected_sdist_stems(package, version)
    return False


def pypi_filename_matches_wheel(filename, package, version):
    """True if filename is a wheel for the known package name and known
    target version. A wheel filename starts with "{distribution}-{version}-",
    where distribution is the project name with runs of -._ collapsed to a
    single underscore."""
    lower = filename.lower()
    if not lower.endswith(".whl"):
        return False
    prefix = f"{pep503_normalize_underscored(package)}-{version}-".lower()
    return lower.startswith(prefix)


def pypi_version_in_filenames(filenames, package, version):
    """Return (found, checked_any). found is True if any filename in the
    list is a valid sdist or wheel for the known package name and known
    target version — both are already known at every call site, since the
    probe always asks "does version V of package P exist", it never needs
    to enumerate versions from unfamiliar filenames. checked_any is False
    when nothing in the list even looked like a package archive filename,
    so the caller can distinguish "we looked and it is absent" from "this
    index's file list could not be read" — the latter must never be
    reported as absence."""
    checked_any = False
    for name in filenames:
        if name.lower().endswith(PYPI_FILENAME_EXTENSIONS):
            checked_any = True
        if pypi_filename_matches_sdist(name, package, version) or \
                pypi_filename_matches_wheel(name, package, version):
            return True, True
    return False, checked_any


def pypi_fetch_index(index, package):
    """GET the simple API page with PEP 691 JSON content negotiation,
    falling back to a PEP 503 HTML page, exactly once — both the
    existence check and the artifact-hash collection are derived from
    this single fetch, so verifying one version never requests the
    index twice.

    Returns (reason, None, url) on any failure (unreachable, redirect,
    non-200, unparseable body, a JSON body with no usable "versions" or
    "files" list, or an unrecognized content type). On success returns
    (None, parsed, url), where parsed is a dict:
      "kind": "json" or "html"
      "versions": the PEP 700 "versions" list when the JSON index
        provides one (exact — pypi.org does), else None (also None for
        an HTML index, which has no such list)
      "files": a list of (filename, sha256_or_none) pairs. filename is
        the PEP 691 "filename" field, or an HTML anchor's text (PEP 503:
        anchor text equals the filename). sha256_or_none is read from
        PEP 691 files[].hashes.sha256, or from an HTML anchor's
        "#sha256=<hex>" URL fragment; None when the index exposes
        neither for that file.

    The PEP 700 "versions" list, when present, is the fast path for the
    existence check — but "files" is always parsed from the same
    response regardless, since a --checksum run needs the file list for
    hash collection even when "versions" alone already answered the
    existence question."""
    url = f"{index.rstrip('/')}/{package}/"
    accept = "application/vnd.pypi.simple.v1+json, text/html;q=0.1"
    marker = "\x1e"
    r = curl(["-H", f"Accept: {accept}",
              "-w", f"{marker}%{{http_code}}{marker}%{{content_type}}", url])
    if r.returncode != 0:
        return f"unreachable (curl exit {r.returncode})", None, url
    body, _, rest = (r.stdout or "").partition(marker)
    code, _, ctype = rest.partition(marker)
    if code in ("404", "410"):
        return f"package not found at the PyPI simple index (HTTP {code})", None, url
    if code.startswith("3"):
        return f"server redirected (HTTP {code}) — redirects are refused", None, url
    if code != "200":
        return f"unexpected HTTP {code}", None, url

    ctype = ctype.split(";")[0].strip().lower()
    if "json" in ctype:
        try:
            doc = json.loads(body)
        except json.JSONDecodeError:
            return "PyPI simple index JSON response was not valid JSON", None, url
        versions_list = doc.get("versions")
        if not isinstance(versions_list, list):
            versions_list = None
        files = doc.get("files")
        if not isinstance(files, list):
            if versions_list is None:
                return ("PyPI simple index JSON response has no usable "
                        "\"versions\" or \"files\" list"), None, url
            files = []
        entries = []
        for f in files:
            if not isinstance(f, dict):
                continue
            filename = f.get("filename", "")
            hashes = f.get("hashes")
            sha = hashes.get("sha256") if isinstance(hashes, dict) else None
            entries.append((filename, sha if isinstance(sha, str) else None))
        return None, {"kind": "json", "versions": versions_list, "files": entries}, url

    if "html" in ctype or body.lstrip().lower().startswith(("<!doctype", "<html")):
        entries = []
        for attrs, text in re.findall(r"<a\b([^>]*)>([^<]+)</a>", body, re.IGNORECASE):
            href_m = re.search(r'href\s*=\s*["\']([^"\']*)["\']', attrs, re.IGNORECASE)
            href = href_m.group(1) if href_m else ""
            frag_m = re.search(r"#sha256=([0-9a-fA-F]{64})\b", href)
            sha = frag_m.group(1).lower() if frag_m else None
            entries.append((text, sha))
        return None, {"kind": "html", "versions": None, "files": entries}, url

    return f"PyPI simple index returned an unrecognized content type ({ctype or 'none'})", None, url


def pypi_version_exists(parsed, package, version):
    """Given a document already fetched by pypi_fetch_index, decide
    whether the requested version is listed. Preferred: the PEP 700
    "versions" list (exact, when the index provides one). Fallback for a
    PEP 691-only JSON index, or an index that answered HTML instead:
    derive versions from the listed file names. Returns None on success,
    or a reason string."""
    if parsed["kind"] == "json" and parsed["versions"] is not None:
        if version in parsed["versions"]:
            return None
        return "version not listed in the PyPI simple index (PEP 700 versions list)"
    filenames = [name for name, _sha in parsed["files"]]
    found, checked_any = pypi_version_in_filenames(filenames, package, version)
    if not checked_any:
        if parsed["kind"] == "json":
            return "PyPI simple index JSON file list had no parseable filenames"
        return "PyPI simple index HTML response had no parseable file links"
    if found:
        return None
    if parsed["kind"] == "json":
        return "version not found among the PyPI simple index's listed files"
    return "version not found among the PyPI simple index's listed files (HTML)"


def pypi_collect_hashes(parsed, package, version):
    """Collect the sha256 of every file in an already-fetched index that
    matches the known package name and target version — the same match
    pypi_version_exists relies on (pypi_filename_matches_sdist /
    pypi_filename_matches_wheel), so "which files belong to this version"
    has exactly one definition. Returns (hashes, incomplete): a set of
    "sha256:<hex>" strings, and whether any matching file carried no
    usable sha256 (missing, or not a bare lowercase-hex digest per
    HASH_RE). The caller must fail on incomplete coverage, not just on an
    empty set: a version whose index gained a digest-less file after
    approval would otherwise compare equal on the digests that remain and
    pass, while an install that selects the uncovered file would fail
    pip's hash check — the verifier exists to surface exactly that drift
    at approval time."""
    hashes = set()
    incomplete = False
    for filename, sha in parsed["files"]:
        if not (pypi_filename_matches_sdist(filename, package, version) or
                pypi_filename_matches_wheel(filename, package, version)):
            continue
        lowered = sha.lower() if isinstance(sha, str) else None
        if lowered and HASH_RE.match(lowered):
            hashes.add(f"sha256:{lowered}")
        else:
            incomplete = True
    return hashes, incomplete


def pypi_normalize_recorded_hash(h):
    """A catalog "hashes" entry is already "sha256:<64 lowercase hex>" per
    schema, but normalize defensively so comparison never depends on that
    holding exactly."""
    h = h.strip().lower()
    return h if h.startswith("sha256:") else f"sha256:{h}"


def pypi_short_hash_list(hashes, limit=3):
    """A short, one-line, human-checkable rendering of a hash set for a
    FAIL message — full 64-hex digests would make the line unreadable, so
    each entry is truncated and the count of any remainder is named."""
    items = sorted(hashes)
    shown = [h[:19] + "..." if len(h) > 19 else h for h in items[:limit]]
    if len(items) > limit:
        shown.append(f"+{len(items) - limit} more")
    return ", ".join(shown)


# --- Shared cargo helpers: kept byte-identical between scripts/add-version
# and scripts/verify-artifacts (see tests/run-approve-tests, which proves
# this in-process). Only the network probe functions below this block
# differ per script, matching the same split the npm/pypi helpers use. ---
def cargo_crate_index_relpath(crate):
    """The crate's path inside a cargo sparse/git index, keyed by name
    length per the registry's documented layout: 1-char names under
    "1/<name>", 2-char under "2/<name>", 3-char under
    "3/<first-char>/<name>", longer under "<first-two>/<next-two>/<name>"
    (e.g. tokei -> to/ke/tokei)."""
    n = len(crate)
    if n == 1:
        return f"1/{crate}"
    if n == 2:
        return f"2/{crate}"
    if n == 3:
        return f"3/{crate[0]}/{crate}"
    return f"{crate[0:2]}/{crate[2:4]}/{crate}"


def cargo_normalize_index_url(url, label):
    """A cargo registry index must be a "sparse+http(s)://" index: it is
    the only index protocol a plain curl probe (or the plugin's runtime)
    can speak. A git-index registry needs a git client to read, which is
    out of scope here, so it is refused by name instead of mis-parsed.
    Exactly the "sparse+" marker is stripped (never a generic prefix
    strip), and the remainder gets the same URL-shape check used
    everywhere else in this script."""
    if not isinstance(url, str) or not url.startswith("sparse+"):
        raise ValueError(
            f"{label} is not a supported cargo index ({url!r}): only a "
            f"sparse+http(s):// index is supported (a git-index registry "
            f"needs a git client, which this script does not use)")
    stripped = url[len("sparse+"):]
    if not URL_RE.match(stripped):
        raise ValueError(f"refusing unsafe {label}: {url!r}")
    return stripped


def cargo_config_index_url():
    """Resolve the cargo index base URL from the user's own cargo
    configuration, the same way "cargo install" itself would:
    [source.crates-io] replace-with = "<name>" in ~/.cargo/config.toml (or
    $CARGO_HOME/config.toml, which replaces the default path outright,
    matching cargo's own CARGO_HOME precedence) points at
    [registries.<name>].index. Absence of any config file, or a
    [source.crates-io] section with the replace-with key entirely absent, is
    not an error — it means the default public index applies, mirroring
    cargo's own default. Once the key is present at all, the public default
    is no longer an option: an empty string, a non-string value, or a name
    with no matching [registries.<name>].index must all hard-error instead
    of silently falling back to the public index, because the user's own
    configuration is asking for something other than the default.
    Returns (url, source) or (None, None) when there is no config at all."""
    import os
    import tomllib

    home = os.environ.get("CARGO_HOME") or os.path.expanduser("~/.cargo")
    config_path = os.path.join(home, "config.toml")
    if not os.path.isfile(config_path):
        return None, None
    try:
        with open(config_path, "rb") as f:
            doc = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ValueError(f"could not read cargo config {config_path}: {e}")
    crates_io = (doc.get("source", {}) or {}).get("crates-io", {}) or {}
    if "replace-with" not in crates_io:
        return None, None
    replace_with = crates_io["replace-with"]
    if not isinstance(replace_with, str) or not replace_with:
        raise ValueError(
            f"{config_path} sets [source.crates-io] replace-with to "
            f"{replace_with!r}, which is not a usable registry name — it must be "
            f"a non-empty string, or the key must be absent entirely to use the "
            f"default public index")
    index = (doc.get("registries", {}) or {}).get(replace_with, {}).get("index")
    if not index:
        raise ValueError(
            f"{config_path} sets [source.crates-io] replace-with = {replace_with!r} "
            f"but there is no [registries.{replace_with}] index — fix the cargo "
            f"config, or pass --cargo-index-url explicitly")
    return index, f"{config_path} [source.crates-io] replace-with = {replace_with!r}"


def cargo_index_url(override):
    """Explicit --cargo-index-url wins outright (same precedence as
    --nexus-url/--goproxy-url/--npm-registry-url/--pypi-index-url);
    otherwise read the user's own cargo configuration; otherwise the
    default public sparse index, matching cargo's own default when nothing
    overrides it. Every candidate goes through the same sparse+ normalizer
    before being returned, so a "wins outright" override cannot skip the
    URL-shape check the other channels get."""
    if override:
        return (cargo_normalize_index_url(override, "--cargo-index-url"),
                "explicit --cargo-index-url")
    configured, source = cargo_config_index_url()
    if configured:
        return cargo_normalize_index_url(configured, "cargo config index"), source
    return (cargo_normalize_index_url("sparse+https://index.crates.io/", "default cargo index"),
            "default (index.crates.io)")


def cargo_version_in_lines(body, version):
    """Parse a cargo sparse/git index file (one JSON object per line, one
    line per version) and look for the requested version. Returns
    (found, checked_any): found is True only for a line whose "vers" field
    equals the requested version AND whose "yanked" field is not true — a
    yanked version cannot be installed ("cargo install" refuses it), so
    treating it as present would let approval accept a version nothing can
    actually install; refusing it at approval time is fail-closed, the same
    stance the catalog takes everywhere else. checked_any is False when no
    line in the body could be parsed as a JSON object with a "vers" field,
    so the caller can tell "we looked and it is absent" from "this index's
    response could not be read" — the latter must never be reported as
    absence, the same distinction the PyPI filename fallback makes above."""
    checked_any = False
    for line in body.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(rec, dict) or "vers" not in rec:
            continue
        checked_any = True
        if rec.get("vers") == version and rec.get("yanked") is not True:
            return True, True
    return False, checked_any
# --- end shared cargo helpers ---


def probe_cargo_version(index, crate, version):
    """GET the crate's index file and look for the requested version; None
    means it exists (and is not yanked). A 200 whose body has no parseable
    version lines is reported as its own reason, distinct from "version not
    listed" — never read a malformed or unreadable response as proof of
    absence."""
    url = f"{index.rstrip('/')}/{cargo_crate_index_relpath(crate)}"
    r = curl(["-w", "\n%{http_code}", url])
    if r.returncode != 0:
        return f"unreachable (curl exit {r.returncode})", url
    body, _, code = (r.stdout or "").rpartition("\n")
    if code in ("404", "410"):
        return f"crate not found at the cargo index (HTTP {code})", url
    if code.startswith("3"):
        return f"server redirected (HTTP {code}) — redirects are refused", url
    if code != "200":
        return f"unexpected HTTP {code}", url
    found, checked_any = cargo_version_in_lines(body, version)
    if not checked_any:
        return "cargo index response had no parseable version lines", url
    if found:
        return None, url
    return "version not listed in the cargo index (or listed only as yanked)", url


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checksum", action="store_true", help="download and verify sha256")
    ap.add_argument("--tool", action="append", help="restrict to these tools")
    ap.add_argument("--nexus-url")
    ap.add_argument("--goproxy-url")
    ap.add_argument("--npm-registry-url",
                    help="npm tools only: explicit override; else npm config get "
                         "[@scope:]registry")
    ap.add_argument("--pypi-index-url",
                    help="pypi tools only: explicit override; else pip config get "
                         "global.index-url")
    ap.add_argument("--cargo-index-url",
                    help="cargo tools only: explicit override; else the index named by "
                         "[source.crates-io] replace-with in ~/.cargo/config.toml (or "
                         "$CARGO_HOME/config.toml), else the default public sparse index")
    ap.add_argument("--catalog-dir", default=str(REPO / "catalog"))
    args = ap.parse_args()

    defaults_file = REPO / "config" / "defaults.json"
    defaults = json.loads(defaults_file.read_text()) if defaults_file.exists() else {}
    nexus = args.nexus_url or defaults.get("nexus_url")
    goproxy = args.goproxy_url or defaults.get("goproxy_url")
    if nexus and not URL_RE.match(nexus):
        sys.exit(f"error: refusing unsafe Nexus URL: {nexus!r}")
    if goproxy and not URL_RE.match(goproxy):
        sys.exit(f"error: refusing unsafe go proxy URL: {goproxy!r}")

    failures = 0
    checked = 0
    skip_reasons = Counter()
    catalog = Path(args.catalog_dir)
    if args.tool:
        known = {p.name for p in catalog.iterdir() if p.is_dir()}
        unknown = sorted(set(args.tool) - known)
        if unknown:
            sys.exit(f"error: unknown tool(s): {', '.join(unknown)} (not in {catalog})")
    for tool_dir in sorted(p for p in catalog.iterdir() if p.is_dir()):
        tool_name = tool_dir.name
        if args.tool and tool_name not in args.tool:
            continue
        try:
            tool = json.loads((tool_dir / "tool.json").read_text())
            versions = json.loads((tool_dir / "versions.json").read_text())
        except (OSError, json.JSONDecodeError) as e:
            sys.exit(f"error: unreadable or invalid catalog file under {tool_dir}: {e}")

        if tool.get("type") == "go":
            if not goproxy:
                sys.exit("error: no go proxy URL (pass --goproxy-url or set "
                         "config/defaults.json goproxy_url)")
            module = tool.get("module", "")
            module_root = tool.get("module_root", module)
            for rec in versions:
                checked += 1
                reason, url = probe_go_version(goproxy, module_root, rec["version"])
                if reason is not None:
                    print(f"FAIL {reason}: {url}")
                    failures += 1
                    continue
                # "go install" resolves a package to the LONGEST module path
                # existing at the requested version; a module nested below
                # module_root would shadow it and unbind the recorded h1 from
                # what actually gets built.
                shadowed = False
                if module_root != module:
                    candidate = module_root
                    for segment in module[len(module_root) + 1:].split("/"):
                        candidate += "/" + segment
                        nested, nurl = probe_go_version(goproxy, candidate, rec["version"])
                        if nested is None:
                            print(f"FAIL nested module {candidate} shadows module_root "
                                  f"{module_root} at v{rec['version']}: {tool_name}")
                            failures += 1
                            shadowed = True
                            break
                        if "not found" not in nested:
                            print(f"FAIL could not probe for nested modules "
                                  f"({nested}): {nurl}")
                            failures += 1
                            shadowed = True
                            break
                if shadowed:
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} (go proxy)")
                    continue
                if "h1" not in rec:
                    print(f"skip sum check: {tool_name} {rec['version']} carries no h1 "
                          f"(proxy-trust entry — nothing to compare against)")
                    skip_reasons["go proxy-trust versions with no h1"] += 1
                    continue
                sum_, reason = go_mod_sum(goproxy, module_root, rec["version"])
                if sum_ is None:
                    print(f"FAIL go mod download ({reason}): {tool_name} {rec['version']}")
                    failures += 1
                elif sum_ != rec["h1"]:
                    print(f"FAIL h1 mismatch: {tool_name} {rec['version']} "
                          f"(catalog {rec['h1']}, got {sum_})")
                    failures += 1
                else:
                    print(f"ok   h1:      {tool_name} {rec['version']}")
            continue

        if tool.get("type") == "npm":
            package = tool.get("package", "")
            registry, _source = npm_registry_url(package, args.npm_registry_url)
            if not registry:
                sys.exit("error: no npm registry URL (pass --npm-registry-url, or configure "
                         "npm: 'npm config set registry <url>')")
            if not URL_RE.match(registry):
                sys.exit(f"error: refusing unsafe npm registry URL: {registry!r}")
            for rec in versions:
                checked += 1
                reason, url = probe_npm_version(registry, package, rec["version"])
                if reason is not None:
                    print(f"FAIL {reason}: {url}")
                    failures += 1
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} (npm registry)")
                    continue
                print(f"skip sum check: {tool_name} {rec['version']} carries no checksum "
                      f"(npm is version-pin only — nothing to compare against)")
                skip_reasons["npm/cargo records and hash-less pypi records are version-pin "
                             "only (no checksum to compare)"] += 1
            continue

        if tool.get("type") == "pypi":
            package = tool.get("package", "")
            index, _source = pip_index_url(args.pypi_index_url)
            if not index:
                sys.exit("error: no PyPI index URL (pass --pypi-index-url, or configure pip: "
                         "'pip config set global.index-url <url>')")
            if not URL_RE.match(index):
                sys.exit(f"error: refusing unsafe PyPI index URL: {index!r}")
            for rec in versions:
                checked += 1
                reason, parsed, url = pypi_fetch_index(index, package)
                if reason is None:
                    reason = pypi_version_exists(parsed, package, rec["version"])
                if reason is not None:
                    print(f"FAIL {reason}: {url}")
                    failures += 1
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} (PyPI simple index)")
                    continue
                if "hashes" not in rec:
                    print(f"skip sum check: {tool_name} {rec['version']} carries no checksum "
                          f"(no hashes recorded for this pypi version — nothing to compare "
                          f"against)")
                    skip_reasons["npm/cargo records and hash-less pypi records are version-pin "
                                 "only (no checksum to compare)"] += 1
                    continue
                collected, incomplete = pypi_collect_hashes(parsed, package, rec["version"])
                if not collected:
                    print(f"FAIL pypi hashes unverifiable: {tool_name} {rec['version']} "
                          f"records {len(rec['hashes'])} sha256 digest(s) but the PyPI "
                          f"simple index exposes no sha256 for this version's files: {url}")
                    failures += 1
                    continue
                if incomplete:
                    print(f"FAIL pypi hashes unverifiable: {tool_name} {rec['version']} has "
                          f"index files with no sha256 digest, so the recorded set cannot be "
                          f"proven complete — re-approve the version once the index exposes "
                          f"a digest for every file: {url}")
                    failures += 1
                    continue
                recorded = {pypi_normalize_recorded_hash(h) for h in rec["hashes"]}
                if recorded == collected:
                    print(f"ok   sha256:  {tool_name} {rec['version']} "
                          f"({len(recorded)} recorded pypi artifact digests match the index)")
                    continue
                missing_from_record = collected - recorded
                unknown_to_index = recorded - collected
                parts = []
                if missing_from_record:
                    parts.append(f"{len(missing_from_record)} index digest(s) missing from "
                                 f"the record ({pypi_short_hash_list(missing_from_record)})")
                if unknown_to_index:
                    parts.append(f"{len(unknown_to_index)} recorded digest(s) unknown to "
                                 f"the index ({pypi_short_hash_list(unknown_to_index)})")
                print(f"FAIL pypi sha256 mismatch: {tool_name} {rec['version']} "
                      f"({'; '.join(parts)}): {url}")
                failures += 1
            continue

        if tool.get("type") == "cargo":
            crate = tool.get("crate", "")
            try:
                index, _source = cargo_index_url(args.cargo_index_url)
            except ValueError as e:
                sys.exit(f"error: {e}")
            for rec in versions:
                checked += 1
                reason, url = probe_cargo_version(index, crate, rec["version"])
                if reason is not None:
                    print(f"FAIL {reason}: {url}")
                    failures += 1
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} (cargo index)")
                    continue
                print(f"skip sum check: {tool_name} {rec['version']} carries no checksum "
                      f"(cargo is version-pin only — nothing to compare against)")
                skip_reasons["npm/cargo records and hash-less pypi records are version-pin "
                             "only (no checksum to compare)"] += 1
            continue

        if not nexus:
            sys.exit("error: no Nexus URL (pass --nexus-url or set config/defaults.json)")
        for rec in versions:
            for plat, pdata in rec["platforms"].items():
                artifact = tool["platforms"][plat]["artifact"].replace("{version}", rec["version"])
                url = f"{nexus}/{tool_name}/{rec['version']}/{artifact}"
                checked += 1
                reason = probe(url)
                if reason is not None:
                    print(f"FAIL {reason}: {url}")
                    failures += 1
                    continue
                if not args.checksum:
                    print(f"ok   exists:  {tool_name} {rec['version']} {plat}")
                    continue
                with tempfile.NamedTemporaryFile() as tmp:
                    r = curl(["-o", tmp.name, url], text=False, follow=True)
                    if r.returncode != 0:
                        detail = (r.stderr or b"").decode(errors="replace").strip().splitlines()
                        cause = detail[0] if detail else f"curl exit {r.returncode}"
                        print(f"FAIL download ({cause}): {url}")
                        failures += 1
                        continue
                    h = hashlib.sha256()
                    with open(tmp.name, "rb") as fh:
                        for chunk in iter(lambda: fh.read(1 << 20), b""):
                            h.update(chunk)
                    if h.hexdigest() != pdata["sha256"]:
                        print(f"FAIL sha256 mismatch: {tool_name} {rec['version']} {plat} "
                              f"(catalog {pdata['sha256']}, got {h.hexdigest()})")
                        failures += 1
                    else:
                        print(f"ok   sha256:  {tool_name} {rec['version']} {plat}")

    mode = "existence+checksum" if args.checksum else "existence"
    total_skipped = sum(skip_reasons.values())
    if total_skipped:
        detail = "; ".join(f"{n} {reason}" for reason, n in skip_reasons.items())
        mode += f", {total_skipped} skipped ({detail})"
    if checked == 0:
        print("verify-artifacts: FAILED — the selection matched no artifacts", file=sys.stderr)
        return 1
    if failures:
        print(f"verify-artifacts: {failures}/{checked} FAILED [{mode}]", file=sys.stderr)
        return 1
    print(f"verify-artifacts: OK — {checked} artifact(s) verified [{mode}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
