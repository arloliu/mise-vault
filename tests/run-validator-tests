#!/usr/bin/env python3
# Validator rejection tests: the catalog is the security boundary, so the
# validator must provably reject unsafe or malformed catalog entries, not
# only accept the good ones.
#
#   1. the real catalog must validate
#   2. every case under tests/fixtures/invalid-catalog/<case>/ must be
#      rejected by the built-in engine (always available, no dependencies)
#   3. when the jsonschema package is installed (as in CI), the cases a
#      formal schema can express must ALSO be rejected by the schemas ALONE
#      (--engine schema) — this is what keeps the two rule sets from
#      drifting apart: a schema gap fails here even though the built-in
#      engine would still have caught the bad entry
#
# No network needed. Exit 0 = all good, 1 = any failure.
import importlib.util
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib.harness import Suite, run

ROOT = Path(__file__).resolve().parent.parent
VALIDATE = str(ROOT / "scripts" / "validate-catalog")
FIXTURES = ROOT / "tests" / "fixtures" / "invalid-catalog"
# cases a formal JSON Schema can express on its own (single-file shape rules);
# the rest are cross-file rules that only the built-in/cross checks cover.
# go-version-has-platforms, artifact-version-has-h1, go-module-name-mismatch,
# and go-module-root-not-prefix are all deliberately absent here: telling a
# go-shaped version record from an artifact-shaped one (or a tool's module
# from its own name) needs the other file, which a single JSON Schema can
# never see — those four are built-in/cross-check-only by design.
# The same reasoning excludes several npm/pypi cases: npm-bin-default-name-
# too-long needs tool.json's "name" cross-checked against the bin grammar;
# npm-version-double-plus, npm-version-is-pypi-shaped, pypi-version-hyphen-
# abuse, and pypi-version-is-npm-shaped are versions that fail their OWN
# ecosystem's grammar but still satisfy another ecosystem's bare "version"
# shape (or go's very permissive one), so only the cross-file dispatch on
# tool.json's declared type — not the schema's anyOf across all shapes —
# catches them.
SCHEMA_CASES = ["artifact-traversal", "artifact-shell-metacharacters",
                "artifact-missing-version", "bin-path-absolute",
                "bin-path-traversal", "bad-sha256", "unknown-field",
                "invalid-format", "go-module-shell-metacharacters",
                "go-module-dot-segment", "go-module-uppercase",
                "go-module-dot-edge", "go-version-v-prefix",
                "go-version-uppercase", "go-module-trailing-newline",
                "npm-package-shell-metacharacters", "npm-package-uppercase",
                "npm-package-trailing-newline", "npm-scope-missing-name",
                "npm-scope-double-slash", "npm-at-inside-name",
                "npm-package-too-long", "npm-bin-slash", "npm-bin-uppercase",
                "npm-version-uppercase-prerelease",
                "pypi-package-shell-metacharacters", "pypi-package-uppercase",
                "pypi-package-trailing-newline", "pypi-package-non-normalized",
                "pypi-package-double-hyphen", "pypi-bin-slash",
                "pypi-bin-uppercase", "pypi-version-uppercase",
                "pypi-version-uppercase-local"]
MIN_CASES = 47

s = Suite("run-validator-tests")

r = run([VALIDATE])
s.check("real catalog accepted", r.ok,
        detail="real catalog must validate cleanly: " + r.tail())

# a vanished fixture directory must fail the suite, not silently skip it
cases = sorted(p for p in FIXTURES.iterdir() if p.is_dir()) if FIXTURES.is_dir() else []
s.check(f"fixture matrix present ({len(cases)} cases, expected >= {MIN_CASES})",
        len(cases) >= MIN_CASES,
        detail=f"found under {FIXTURES}")

for case in cases:
    r = run([VALIDATE, "--engine", "builtin", "--catalog-dir", str(case)])
    s.check(f"built-in engine rejects: {case.name}", not r.ok,
            detail="output: " + r.tail())

# positive coverage: tests/fixtures/catalog holds one valid sample per tool
# shape (go-sample, npm-sample, pypi-sample, plus the artifact-shaped ones),
# validated together the way the real catalog is.
GO_SAMPLE = ROOT / "tests" / "fixtures" / "catalog" / "go-sample"
SAMPLES = GO_SAMPLE.parent
r = run([VALIDATE, "--engine", "builtin", "--catalog-dir", str(SAMPLES)])
s.check("built-in engine accepts valid go/npm/pypi tools", r.ok, detail="output: " + r.tail())

if importlib.util.find_spec("jsonschema"):
    for name in SCHEMA_CASES:
        r = run([VALIDATE, "--engine", "schema", "--catalog-dir", str(FIXTURES / name)])
        s.check(f"schemas alone reject: {name}", not r.ok,
                detail="schemas/ has drifted behind the built-in rules; output: " + r.tail())
    r = run([VALIDATE, "--engine", "schema", "--catalog-dir", str(SAMPLES)])
    s.check("schemas alone accept valid go/npm/pypi tools", r.ok, detail="output: " + r.tail())
else:
    s.note("jsonschema not installed — schema-only passes skipped (CI runs them)", tag="NOTE")

sys.exit(s.finish())
