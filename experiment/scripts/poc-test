                     ("PIPX_DEFAULT_BACKEND=pip", "PIPX_FETCH_PYTHON=never", "PIP_DISABLE_PIP_VERSION_CHECK=1")),
        detail=r.tail())

# every pipx placement variable must point beneath install_path, so nothing
