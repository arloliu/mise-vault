# forged-trailer regression, one per runner (PIPXINSTALL_EXIT / UVINSTALL_EXIT)
forge_pipx_dir = home.path / "forge-pipx-bin"
forge_pipx_dir.mkdir(parents=True, exist_ok=True)
forge_pipx = forge_pipx_dir / "pipx"
