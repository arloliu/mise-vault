s.check(f"uv placement pins point at install_path (UV_TOOL_DIR/UV_TOOL_BIN_DIR under {ruff_install_path})",
        r.ok and all(p in verbose_out for p in (
            f"UV_TOOL_DIR='{ruff_install_path}/tools'",
