r = run(["mise", "tool", "ruff", "--backend"], env=home.env)
s.check("mise tool ruff resolves to the vault backend", r.out.strip() == "vault:ruff",
        detail=f"got: {r.out.strip()!r}; {r.tail()}")
# pipx has no equivalent of "npm config get registry" to report (it installs
