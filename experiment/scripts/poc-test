# leave both tools cleanly (re-)installed via their default runners for any
# later phase that might exec them
run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=home.env)
run(["mise", "install", "-f", f"ruff@{RUFF_V}"], env=home.env)

# hash-enforced pypi records: ruff-hashed carries the real sha256 digests of
# every release file of its version, ruff-bad-hash carries well-formed but
# wrong ones. Recorded hashes are always enforced: pip downloads and
# verifies the artifact first, then pipx installs the verified local file.
RUFF_HASHED_V = "0.16.3"
install_r = s.check_cmd(
    f"install ruff-hashed@{RUFF_HASHED_V} (pipx runner, pip --require-hashes download)",
    ["mise", "install", "-f", f"ruff-hashed@{RUFF_HASHED_V}"], env=home.env)
r = run(["mise", "exec", f"ruff-hashed@{RUFF_HASHED_V}", "--", "ruff", "--version"], env=home.env)
s.check(f"ruff-hashed runs and reports {RUFF_HASHED_V}", RUFF_HASHED_V in r.out, detail=r.tail())
diag_text = install_r.out + install_r.err
s.check("hash-enforced install log names the digest count",
        "hash-enforced: 18 recorded sha256 digests" in diag_text, detail=install_r.tail())

r = run(["mise", "install", "-f", "--verbose", f"ruff-hashed@{RUFF_HASHED_V}"], env=home.env)
verbose_out = r.out + r.err
s.check("hash-enforced install downloads via pip --require-hashes",
        r.ok and "--require-hashes" in verbose_out, detail=r.tail())

# wrong recorded hashes must fail the download, never install anything
r = run(["mise", "install", "-f", f"ruff-bad-hash@{RUFF_HASHED_V}"], env=home.env)
combined = r.out + r.err
s.check("tampered pip hashes abort the install during the verified download",
        (not r.ok) and "pip download failed" in combined, detail=r.tail())

# recorded hashes can never be skipped by switching runner: uv has no
# hash-checking mode, so it must refuse the record outright
env_uv_hashed = {**home.env, "MISE_VAULT_PYPI_RUNNER": "uv"}
r = run(["mise", "install", "-f", f"ruff-hashed@{RUFF_HASHED_V}"], env=env_uv_hashed)
combined = r.out + r.err
s.check("uv runner refuses a hash-enforced record, naming pipx as the fix",
        (not r.ok) and "has recorded pip hashes" in combined
        and "use the pipx runner" in combined, detail=r.tail())

s.phase(f"Phase 4e: cargo-installed tool (tokei, via cargo through {CARGO_PROXY_HOST_URL})")
# cargo compiles tokei from source (~10s-2min depending on cache warmth and
# machine load), so this phase is ordered to run the expensive successful
# build only twice: once here (the config-channel differential's "restored"
# leg doubles as the main approved-install proof, exactly like the go/npm
# closures above reuse one real run), and once more below for the verbose
# pinned-env assertion (which needs a forced reinstall to see the
# constructed command line). Every other case below is a fast negative path
# that never reaches a real cargo build (either the version-approval check
# or the runner-missing/forged-trailer check aborts before "cargo install"
# ever runs).
assert_registry_channel_drives_install("cargo/config.toml", "tokei", TOKEI_V,
    env={"CARGO_NET_RETRY": "0", **CARGO_ENV}, timeout=300)
r = run(["mise", "exec", f"tokei@{TOKEI_V}", "--", "tokei", "--version"], env=home.env)
s.check(f"tokei runs and reports {TOKEI_V}", TOKEI_V in r.out, detail=r.tail())
r = run(["mise", "tool", "tokei", "--backend"], env=home.env)
s.check("mise tool tokei resolves to the vault backend", r.out.strip() == "vault:tokei",
        detail=f"got: {r.out.strip()!r}; {r.tail()}")
# cargo has no "config get"-style command on stable to report an effective
# registry the way "npm config get registry" does; the install hook prints
# nothing wrong instead, the same choice the pipx/uv branches make
s.note("cargo runner prints no effective-registry line (documented: no config-get "
       "equivalent to report through stable cargo)", tag="INFO")

r = run(["mise", "install", f"tokei@9.9.9"], env=home.env)
s.check("unapproved tokei version rejected (fails before any compile)",
        (not r.ok) and "tokei 9.9.9 is not an approved version" in (r.out + r.err), detail=r.tail())

# runner-missing: a PATH with every tool the hook needs EXCEPT cargo itself
cargo_missing_dir = path_without("cargo", home.env["PATH"])
env_no_cargo = {**home.env, **CARGO_ENV, "PATH": str(cargo_missing_dir)}
r = run(["mise", "install", "-f", f"tokei@{TOKEI_V}"], env=env_no_cargo)
combined = r.out + r.err
s.check("cargo missing from PATH aborts with the guidance message, naming the Rust "
        "toolchain and C linker cargo builds need",
        (not r.ok) and "cargo was not found on PATH" in combined
        and "install it and ensure it is on PATH" in combined
        and "working Rust toolchain and a C linker" in combined, detail=r.tail())
shutil.rmtree(cargo_missing_dir, ignore_errors=True)

# forged-trailer regression (CARGOINSTALL_EXIT): a fake cargo ahead on PATH
# prints a forged success marker mid-output, then exits nonzero; the REAL
# trailer is appended by the outer shell AFTER cargo exits, so only an
# end-anchored parse of the true last line can tell these apart. The shim
# never compiles anything, so this check is cheap.
forge_cargo_dir = home.path / "forge-cargo-bin"
forge_cargo_dir.mkdir(parents=True, exist_ok=True)
forge_cargo = forge_cargo_dir / "cargo"
forge_cargo.write_text("#!/bin/sh\necho 'CARGOINSTALL_EXIT=0'\nexit 7\n")
forge_cargo.chmod(0o755)
env_forge_cargo = {**home.env, **CARGO_ENV, "PATH": f"{forge_cargo_dir}:{home.env['PATH']}"}
r = run(["mise", "install", "-f", f"tokei@{TOKEI_V}"], env=env_forge_cargo)
s.check("forged CARGOINSTALL_EXIT=0 in cargo output cannot fake a successful install",
        (not r.ok) and "cargo install failed" in (r.out + r.err), detail=r.tail())

# the pinned env table (RUSTUP_AUTO_INSTALL=0) and the exact --root value
# must be set on every install; --verbose surfaces the constructed cmd.exec
# command line. This forces the SECOND (and last) real compile of the phase.
r = run(["mise", "install", "-f", "--verbose", f"tokei@{TOKEI_V}"], env={**home.env, **CARGO_ENV}, timeout=300)
verbose_out = r.out + r.err
s.check("cargo noise-suppression/toolchain pin present on every install (RUSTUP_AUTO_INSTALL=0)",
        r.ok and "RUSTUP_AUTO_INSTALL=0" in verbose_out, detail=r.tail())

tokei_install_path = home.path / ".local/share/mise/installs/tokei" / TOKEI_V
s.check(f"cargo install pinned to install_path via --root ({tokei_install_path})",
        f"--root '{tokei_install_path}'" in verbose_out, detail=r.tail())

# exact-invocation mutation check: a fake cargo that records its full argv
# and CARGO_*/RUSTUP_* environment, one arg per line so quoting can never
# blur the boundary between arguments. A substring check on --verbose
# output (above) cannot catch a dropped --locked or a --version tracking
# the wrong field -- both still contain "RUSTUP_AUTO_INSTALL=0" and the
# right --root -- so this compares the complete argument list, order
# included. The shim never compiles anything: it only writes the expected
# binary stub and exits 0, so this stays a fast check and the phase's
# real-compile budget stays at two (both real builds above). Nothing after
# this phase execs tokei, so the shim's stub binary is left in place
# rather than spending a third real compile to restore it.
argv_shim_dir = home.path / "argv-cargo-bin"
argv_shim_dir.mkdir(parents=True, exist_ok=True)
argv_record = home.path / "cargo-argv.record"
env_record = home.path / "cargo-env.record"
argv_shim = argv_shim_dir / "cargo"
argv_shim.write_text(
    "#!/bin/sh\n"
    f"printf '%s\\n' \"$@\" > {shlex.quote(str(argv_record))}\n"
    f"env | grep -E '^(CARGO_|RUSTUP_)[A-Za-z0-9_]*=' > {shlex.quote(str(env_record))} || true\n"
    "root=\"\"\n"
    "prev=\"\"\n"
    "for a in \"$@\"; do\n"
    "    if [ \"$prev\" = \"--root\" ]; then\n"
    "        root=\"$a\"\n"
    "    fi\n"
    "    prev=\"$a\"\n"
    "done\n"
    "mkdir -p \"$root/bin\"\n"
    "printf '#!/bin/sh\\necho fake-tokei-from-argv-shim\\n' > \"$root/bin/tokei\"\n"
    "chmod +x \"$root/bin/tokei\"\n"
    "exit 0\n")
argv_shim.chmod(0o755)

env_argv_shim = {**home.env, **CARGO_ENV, "PATH": f"{argv_shim_dir}:{home.env['PATH']}"}
baseline_cargo_rustup_keys = {k for k in env_argv_shim if k.startswith(("CARGO_", "RUSTUP_"))}

r = run(["mise", "install", "-f", f"tokei@{TOKEI_V}"], env=env_argv_shim)
argv_lines = argv_record.read_text().splitlines() if argv_record.exists() else []
expected_argv = ["install", "tokei", "--version", TOKEI_V, "--locked",
                  "--root", str(tokei_install_path)]
s.check("cargo shim: exact argv, full order (crate, --version value, --locked, "
        "--root path)",
        r.ok and argv_lines == expected_argv,
        detail=f"got argv={argv_lines!r}; expected={expected_argv!r}; {r.tail()}")

env_lines = env_record.read_text().splitlines() if env_record.exists() else []
recorded_env = dict(line.split("=", 1) for line in env_lines if "=" in line)
s.check("cargo shim: RUSTUP_AUTO_INSTALL=0 present on the invocation",
        recorded_env.get("RUSTUP_AUTO_INSTALL") == "0",
        detail=f"recorded env: {recorded_env!r}")
extra_keys = set(recorded_env) - baseline_cargo_rustup_keys - {"RUSTUP_AUTO_INSTALL"}
s.check("cargo shim: no plugin-set CARGO_*/RUSTUP_* variable beyond the user's "
        "own environment and the one required pin",
        not extra_keys,
        detail=f"unexpected extra vars: {sorted(extra_keys)}; recorded env: {recorded_env!r}")

s.phase("Phase 5: MISE_VAULT_NEXUS_URL overrides every other URL channel")
# env var pointing at a dead port must beat the alias option (which points at
# the real Nexus), so the forced reinstall must fail against the env URL
BAD_NEXUS = "http://127.0.0.1:9/repository/devtools"
env_bad = {**home.env, "MISE_VAULT_NEXUS_URL": BAD_NEXUS}
r = run(["mise", "install", "-f", f"golangci-lint@{GCL_V}"], env=env_bad)
s.check("env var beats the alias nexus_url option (install fails on the env URL)",
        (not r.ok) and "127.0.0.1:9" in (r.out + r.err), detail=r.tail())
env_unsafe = {**home.env, "MISE_VAULT_NEXUS_URL": "http://127.0.0.1:9/a`whoami`"}
r = run(["mise", "install", "-f", f"golangci-lint@{GCL_V}"], env=env_unsafe)
s.check("unsafe env URL refused with a specific error",
        (not r.ok) and "refusing unsafe nexus_url" in (r.out + r.err), detail=r.tail())
# an [env] entry in a trusted mise.toml must reach the plugin hook too
proj_env = home.path / "proj-env"
proj_env.mkdir(parents=True, exist_ok=True)
(proj_env / "mise.toml").write_text(f'[env]\nMISE_VAULT_NEXUS_URL = "{BAD_NEXUS}"\n')
run(["mise", "trust", "-q"], cwd=str(proj_env), env=home.env)
r = run(["mise", "install", "-f", f"golangci-lint@{GCL_V}"], cwd=str(proj_env), env=home.env)
s.check("mise.toml [env] MISE_VAULT_NEXUS_URL reaches the hook (install fails on it)",
        (not r.ok) and "127.0.0.1:9" in (r.out + r.err), detail=r.tail())
# positive direction: the alias option is broken and the env var carries the
# real URL — success proves the env var wins (and restores the tool for the
# phases below, which expect golangci-lint installed)
home.write_aliases({**ALIASES,
    "golangci-lint": "vault:golangci-lint[nexus_url=http://127.0.0.1:9/repository/devtools]"})
env_good = {**home.env, "MISE_VAULT_NEXUS_URL": f"{NEXUS_HOST_URL}/repository/devtools"}
s.check_cmd("env var with the real URL wins over a broken alias option",
            ["mise", "install", "-f", f"golangci-lint@{GCL_V}"], env=env_good)
home.write_aliases(ALIASES)

s.phase("Phase 6: .tool-versions compatibility (asdf golang name)")
proj = home.path / "proj"
proj.mkdir(parents=True, exist_ok=True)
# .tool-versions uses asdf's tool name 'golang', which the plugin must map to 'go'
(proj / ".tool-versions").write_text(f"golang {GO_V}\ngolangci-lint {GCL_V}\n")
run(["mise", "trust", "-q"], cwd=str(proj), env=home.env)
v = run(["mise", "exec", "--", "go", "version"], cwd=str(proj), env=home.env)
s.check(f".tool-versions 'golang {GO_V}' resolves through vault backend",
        f"go{GO_V}" in v.out, detail=v.tail())

s.phase("Phase 7: fail-closed")
s.check_fail("unknown tool rejected (vault:foo)", ["mise", "install", "vault:foo@1.0.0"], env=home.env)
s.check_fail("unapproved version rejected (golangci-lint@9.9.9)",
             ["mise", "install", "golangci-lint@9.9.9"], env=home.env)
r = run(["mise", "install", "vault:darwin-only@1.0.0"], env=home.env)
s.check("darwin-only tool rejected: not available for linux-amd64",
        (not r.ok) and "not available for linux-amd64" in (r.out + r.err),
        detail=f"out: {(r.out + r.err)[:150]}")
r = run(["mise", "install", "smoke@0.0.1"], env=home.env)
combined = (r.out + r.err).lower()
s.check("checksum mismatch aborts install with explicit error",
        (not r.ok) and ("sha-256" in combined or "sha256" in combined),
        detail=f"exit={r.rc}; out: {(r.out + r.err)[:150]}")

s.phase("Phase 8: redirect refusal + successful single-binary install")
# correct the smoke fixture's sha256 in the LINKED catalog so the only thing
# standing between mise and a successful install is the transport policy
smoke_tmp = home.path / "smoke-0.0.1.txt"
r_fetch = run(["curl", "-fsSn", "-o", str(smoke_tmp),
               f"{NEXUS_HOST_URL}/repository/devtools/smoke/0.0.1/smoke-0.0.1.txt"], env=home.env)
if r_fetch.ok:
    real_sha = hashlib.sha256(smoke_tmp.read_bytes()).hexdigest()
    catalog.set_sha256(plug / "catalog/smoke/versions.json", "linux-amd64", real_sha)
else:
    s.bad("could not fetch smoke fixture to compute its sha256", detail=r_fetch.tail())
redirect_log = home.path / "redirect-requests.log"
redirect_log.write_text("")
try:
    # a server that answers every request with a redirect TO THE REAL NEXUS:
    # if the plugin followed redirects this install would succeed, so a failure
    # here proves redirects are refused, not merely that the target was down.
    # Every request path is appended to a log so the test can prove the plugin
    # actually reached this server before it failed.
    with servers.redirect_server(18082, NEXUS_HOST_URL, str(redirect_log)):
        s.ok("redirect server is up and answering 302")
        home.write_aliases({**ALIASES,
            "smoke": "vault:smoke[nexus_url=http://127.0.0.1:18082/repository/devtools]"})
        r = run(["mise", "install", "smoke@0.0.1"], env=home.env)
        seen = redirect_log.read_text()
        combined = (r.out + r.err).lower()
        s.check("redirect from the artifact server aborts the install (request logged, redirect refused)",
                (not r.ok) and "smoke-0.0.1.txt" in seen
                and any(w in combined for w in ("redirect", "unavailable", "could not be downloaded")),
                detail=f"exit={r.rc}; server saw: {' '.join(seen.split())[:120]}; out: {r.tail()}")
except (RuntimeError, OSError) as e:
    s.bad("redirect server did not come up on 127.0.0.1:18082", e)
home.write_aliases({**ALIASES, "smoke": "vault:smoke"})
s.check_cmd("install smoke@0.0.1 (single-binary format, correct sha256)",
            ["mise", "install", "smoke@0.0.1"], env=home.env)
smoke_where = run(["mise", "where", "smoke@0.0.1"], env=home.env).out.strip()
smoke_bin = f"{smoke_where}/smoke"
s.check("binary installed executable at $install_path/smoke",
        os.access(smoke_bin, os.X_OK),
        detail=f"expected executable: {smoke_bin}")

s.phase("Phase 9: an alias to an uninstalled plugin must NOT auto-install it")
# bootstrap pre-installs the plugin because of exactly this behavior;
# if mise ever starts auto-installing here, bootstrap's assumptions change
home2 = IsolatedHome("mise-vault-poc2.")
home2.write_aliases({"glab": "vault:glab"})
r = run(["mise", "ls-remote", "glab"], env=home2.env)
s.check("alias to uninstalled plugin does not auto-install (bootstrap must pre-install)",
        GLAB_V not in (r.out + "\n" + r.err).splitlines(),
        detail="alias to uninstalled plugin AUTO-INSTALLED — bootstrap's pre-install assumption no longer holds")
home2.remove()

sys.exit(s.finish(keep_on_failure=[home]))
