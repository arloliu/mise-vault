#!/usr/bin/env python3
# mise-vault PoC test matrix: plugin behavior against the local Docker stack.
# Runs entirely inside an isolated HOME so the real machine config is untouched.
#
# Structure:
#   Phase 1 exercises the plugin LIFECYCLE (install / re-pin over git + netrc)
#   using pinned experiment tags (defaults v0.0.3 / v0.0.4; override with
#   EXPERIMENT_TAG_A / EXPERIMENT_TAG_B).
#   Phase 2 then links the CURRENT WORKING TREE as the plugin, so every
#   behavior check from phase 3 on runs the exact code under review —
#   the reviewed commit is printed and never hidden behind a stale tag.
#
# Requires: experiment stack up + provisioned + seeded; the lifecycle tags present.
import hashlib
import json
import os
import shlex
import shutil
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT / "tests"))
from lib import catalog, servers
from lib.env import GITLAB_HOST_URL, NEXUS_HOST_URL, IsolatedHome
from lib.harness import Suite, run

# immutable experiment tags used only by the lifecycle phase; override when a
# fresh experiment GitLab carries different tags
TAG_A = os.environ.get("EXPERIMENT_TAG_A", "v0.0.3")
TAG_B = os.environ.get("EXPERIMENT_TAG_B", "v0.0.4")
PLUGIN_URL = f"{GITLAB_HOST_URL}/devtools/mise-vault.git"

# expected versions come from the working-tree catalog, so approving a new
# version never requires editing this suite
GCL_ALL = " ".join(catalog.versions("golangci-lint", REPO_ROOT))
GCL_V = catalog.latest("golangci-lint", REPO_ROOT)
GLAB_V = catalog.latest("glab", REPO_ROOT)
GO_V = catalog.latest("go", REPO_ROOT)
GOCENSUS_V = catalog.latest("gocensus", REPO_ROOT)
GOCENSUS_ALL = catalog.versions("gocensus", REPO_ROOT)
PRETTIER_V = catalog.latest("prettier", REPO_ROOT)
RUFF_V = catalog.latest("ruff", REPO_ROOT)
SPECTRAL_V = catalog.latest("spectral", REPO_ROOT)
TOKEI_V = catalog.latest("tokei", REPO_ROOT)

# A rustup-managed cargo stores its toolchain-selection state under
# RUSTUP_HOME, which defaults to $HOME/.rustup on whatever machine cargo
# was installed on. This suite swaps $HOME for every check via
# IsolatedHome, so a rustup-shim cargo on a bare host (nothing already
# exporting RUSTUP_HOME) would otherwise see no installed toolchain inside
# the isolated home and fail with "no default is configured" — a
# test-harness artifact, not a real-machine failure (a real "mise install"
# always runs with the developer's own $HOME intact). The offline gate's
# test image sidesteps this entirely by pinning RUSTUP_HOME explicitly via
# the container's own environment (test-image/Dockerfile), which
# IsolatedHome.env already preserves untouched — this fallback only fires
# when nothing already set RUSTUP_HOME.
_HOST_RUSTUP_HOME = os.environ.get("RUSTUP_HOME") or os.path.join(
    os.environ.get("HOME", os.path.expanduser("~")), ".rustup")
CARGO_ENV = {"RUSTUP_HOME": _HOST_RUSTUP_HOME} if os.path.isdir(_HOST_RUSTUP_HOME) else {}

s = Suite("poc-test")
home = IsolatedHome("mise-vault-poc.")

# bun is commonly installed to $HOME/.bun/bin by its own installer, which
# only reaches PATH via a shell-profile line this suite never sources (it
# runs every command through an isolated $HOME with its own explicit PATH).
# That is a test-harness artifact, not a real-machine failure: a real
# developer's interactive shell has already sourced their profile before
# they ever run "mise install". The offline gate's test image installs bun
# to /usr/local/bin, which is already on PATH there, so this fallback never
# fires in that environment.
_HOST_BUN_BIN = os.path.join(os.environ.get("HOME", os.path.expanduser("~")), ".bun", "bin")
_NEED_BUN_PATH = shutil.which("bun") is None and os.path.isfile(os.path.join(_HOST_BUN_BIN, "bun"))


def bun_env(extra=None):
    """home.env plus the bun runner selection (and the host ~/.bun/bin
    PATH fallback when bun is not already reachable)."""
    e = {**home.env, "MISE_VAULT_NPM_RUNNER": "bun", **(extra or {})}
    if _NEED_BUN_PATH:
        e["PATH"] = f"{_HOST_BUN_BIN}:{e['PATH']}"
    return e

# the generated conf.d file (aliases + nexus_url option per tool)
# one alias keeps an explicit URL option to cover the override channel
GOPROXY_HOST_URL = f"{NEXUS_HOST_URL}/repository/go-proxy"
NPM_PROXY_URL = f"{NEXUS_HOST_URL}/repository/npm-proxy/"
PYPI_PROXY_SIMPLE_URL = f"{NEXUS_HOST_URL}/repository/pypi-proxy/simple"
CARGO_PROXY_HOST_URL = f"{NEXUS_HOST_URL}/repository/cargo-proxy"
NEXUS_HOST = NEXUS_HOST_URL.split("//", 1)[1].split("/", 1)[0]  # "127.0.0.2:8081"
NEXUS_HOSTNAME = NEXUS_HOST.split(":", 1)[0]                    # "127.0.0.2"
ALIASES = {
    "go": "vault:go",
    "glab": "vault:glab",
    "smoke": "vault:smoke",
    "gocensus": "vault:gocensus",
    "gocensus-bad-h1": "vault:gocensus-bad-h1",
    "ruff-hashed": "vault:ruff-hashed",
    "ruff-bad-hash": "vault:ruff-bad-hash",
    "golangci-lint": f"vault:golangci-lint[nexus_url={NEXUS_HOST_URL}/repository/devtools]",
    "prettier": "vault:prettier",
    "ruff": "vault:ruff",
    "spectral": "vault:spectral",
    "tokei": "vault:tokei",
}
home.write_aliases(ALIASES)


def write_ecosystem_registry_config(home):
    """USER-ENV registry configuration, mirroring the production shapes:
    npm/pypi/cargo tool types have no MISE_VAULT_*_REGISTRY channel at
    all — they inherit whatever the user's own toolchain config says, so
    the plugin never touches these files. All plain http, matching the
    experiment Nexus."""
    (home.path / ".npmrc").write_text(f"registry={NPM_PROXY_URL}\n")
    pip_dir = home.path / ".config/pip"
    pip_dir.mkdir(parents=True, exist_ok=True)
    (pip_dir / "pip.conf").write_text(
        "[global]\n"
        f"index-url = {PYPI_PROXY_SIMPLE_URL}\n"
        f"trusted-host = {NEXUS_HOSTNAME}\n")
    # uv reads only user-level (~/.config/uv/uv.toml) and system-level
    # config for "uv tool" commands, never a project-local uv.toml, so
    # the file must live at the user level for this to take effect.
    uv_dir = home.path / ".config/uv"
    uv_dir.mkdir(parents=True, exist_ok=True)
    (uv_dir / "uv.toml").write_text(
        f'index-url = "{PYPI_PROXY_SIMPLE_URL}"\n'
        f'allow-insecure-host = ["{NEXUS_HOST}"]\n')
    # cargo reads its registry from ~/.cargo/config.toml source
    # replacement; the trailing slash on the sparse index matches the
    # layout confirmed empirically against this Nexus build (config.json
    # + name-length-keyed index paths served straight under the
    # repository root).
    cargo_dir = home.path / ".cargo"
    cargo_dir.mkdir(parents=True, exist_ok=True)
    (cargo_dir / "config.toml").write_text(
        '[source.crates-io]\n'
        'replace-with = "nexus-cargo"\n'
        '\n'
        '[registries.nexus-cargo]\n'
        f'index = "sparse+{CARGO_PROXY_HOST_URL}/"\n')


write_ecosystem_registry_config(home)


def write_broken_registry_config(home):
    """The same dead-port pattern Phase 5 uses for MISE_VAULT_NEXUS_URL,
    applied to all four USER-ENV files: nothing listens on 127.0.0.1:9, so
    a connection to it fails immediately (ECONNREFUSED) instead of a slow
    DNS/routing timeout."""
    (home.path / ".npmrc").write_text("registry=http://127.0.0.1:9/repository/npm-proxy/\n")
    (home.path / ".config/pip/pip.conf").write_text(
        "[global]\n"
        "index-url = http://127.0.0.1:9/repository/pypi-proxy/simple\n"
        "trusted-host = 127.0.0.1\n")
    (home.path / ".config/uv/uv.toml").write_text(
        'index-url = "http://127.0.0.1:9/repository/pypi-proxy/simple"\n'
        'allow-insecure-host = ["127.0.0.1:9"]\n')
    (home.path / ".cargo/config.toml").write_text(
        '[source.crates-io]\n'
        'replace-with = "nexus-cargo"\n'
        '\n'
        '[registries.nexus-cargo]\n'
        'index = "sparse+http://127.0.0.1:9/repository/cargo-proxy/"\n')


def assert_registry_channel_drives_install(desc, tool, version, env=None, timeout=120):
    """Prove the USER-ENV registry file is actually what the runner reads,
    not merely that the install can succeed some other way (e.g. a local
    package-manager cache, or an accidental fall-through to the public
    registry): break the file, the install must fail; restore it, the same
    install must succeed again. The runner's own top-level error text
    varies too much across npm/pipx/uv/cargo (pipx in particular reports its
    own banner line, not the underlying pip error, as mise's captured
    detail) to match reliably on wording, so this checks the BEHAVIOR
    instead. timeout is overridable for cargo: the "restored" install
    compiles from source and a cold cache can take well over the default
    120s budget on a loaded machine."""
    e = {**home.env, **(env or {})}
    write_broken_registry_config(home)
    r_broken = run(["mise", "install", "-f", f"{tool}@{version}"], env=e, timeout=timeout)
    write_ecosystem_registry_config(home)
    r_fixed = run(["mise", "install", "-f", f"{tool}@{version}"], env=e, timeout=timeout)
    s.check(f"{desc}: USER-ENV registry file actually drives the install "
            "(broken index -> fails, restored index -> succeeds again)",
            (not r_broken.ok) and r_fixed.ok,
            detail=f"broken: ok={r_broken.ok} {r_broken.tail()}; restored: ok={r_fixed.ok} {r_fixed.tail()}")


def path_without(binary_name, path_str):
    """A synthetic PATH containing every executable currently reachable
    except the one named, so a runner's own PATH lookup fails to find it
    while every other tool the hook needs (sh, mkdir, curl, sha256sum, mise
    itself, ...) stays available -- simulating "runner not installed"
    without disturbing anything else the hook or its shell needs."""
    synth = Path(tempfile.mkdtemp(prefix="mise-vault-poc-nobin."))
    seen = set()
    for d in path_str.split(":"):
        if not d:
            continue
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for name in names:
            if name in seen or name == binary_name:
                continue
            src = os.path.join(d, name)
            try:
                if os.path.isdir(src) or not os.access(src, os.X_OK):
                    continue
                os.symlink(src, synth / name)
            except OSError:
                continue
            seen.add(name)
    return synth


def link_working_tree():
    """Copy the working tree's plugin files (plus the fixture tools)
    into an isolated plugin dir and link it, so every later check runs
    the exact code under review."""
    plug = home.path / "plugin"
    plug.mkdir()
    shutil.copy(REPO_ROOT / "metadata.lua", plug / "metadata.lua")
    for d in ("hooks", "lib", "config", "catalog"):
        shutil.copytree(REPO_ROOT / d, plug / d)
    # fixtures: darwin-only (unsupported platform), smoke (deliberately wrong
    # sha256), gocensus-bad-h1 (real go module, deliberately wrong h1),
    # ruff-hashed (real pypi package with its real recorded pip hashes),
    # ruff-bad-hash (same package, deliberately wrong hashes)
    for tool in ("darwin-only", "smoke", "gocensus-bad-h1", "ruff-hashed", "ruff-bad-hash"):
        shutil.copytree(REPO_ROOT / "tests/fixtures/catalog" / tool, plug / "catalog" / tool)
    run(["mise", "plugins", "uninstall", "vault"], env=home.env)
    return plug, run(["mise", "plugins", "link", "vault", str(plug)], env=home.env)


s.phase(f"Phase 1: plugin lifecycle over git (netrc, tags {TAG_A} -> {TAG_B})")
s.check_cmd(f"mise plugin install vault <url>#{TAG_A} via netrc",
            ["mise", "plugin", "install", "vault", f"{PLUGIN_URL}#{TAG_A}"], env=home.env)
r = run(["mise", "plugins", "ls"], env=home.env)
s.check("plugin registered", "vault" in r.out, detail=r.tail())
r = run(["mise", "ls-remote", "vault:smoke"], env=home.env)
s.check(f"smoke absent at catalog {TAG_A}", not r.out.strip(), detail=r.tail())
s.check_cmd(f"plugin re-pin to {TAG_B} (catalog update)",
            ["mise", "plugin", "install", "-f", "vault", f"{PLUGIN_URL}#{TAG_B}"], env=home.env)
r = run(["mise", "ls-remote", "smoke"], env=home.env)
s.check("new tool 'smoke' appears after catalog update", "0.0.1" in r.out.splitlines(), detail=r.tail())

s.phase("Phase 2: link the working tree — everything below tests the code under review")
reviewed_r = run(["git", "-C", str(REPO_ROOT), "rev-parse", "HEAD"])
REVIEWED = reviewed_r.out.strip() if reviewed_r.ok else "unknown"
s.note(f"reviewed commit: {REVIEWED} (plus any uncommitted changes in the working tree)")
plug, link_r = link_working_tree()
s.check("working tree linked as the vault plugin", link_r.ok, detail=link_r.tail())

s.phase("Phase 3: version discovery + short-name aliases (catalog only)")
r = run(["mise", "ls-remote", "vault:golangci-lint"], env=home.env)
lsr = " ".join(r.out.split())
s.check(f"ls-remote vault:golangci-lint == exactly catalog ({GCL_ALL})", lsr == GCL_ALL,
        detail=f"got: {lsr}")
r = run(["mise", "ls-remote", "golangci-lint"], env=home.env)
lsr2 = " ".join(r.out.split())
s.check("ls-remote golangci-lint (short name) routed to vault backend", lsr2 == GCL_ALL,
        detail=f"got: {lsr2}")
r = run(["mise", "ls-remote", "go"], env=home.env)
lsgo_lines = r.out.splitlines()
s.check("ls-remote go shows only catalog versions (core backend shadowed)",
        GO_V in lsgo_lines and not any(l.startswith("1.24") for l in lsgo_lines),
        detail=f"got: {r.out[:120]}")
r = run(["mise", "ls-remote", "vault:gocensus"], env=home.env)
lsgc = " ".join(r.out.split())
s.check(f"ls-remote vault:gocensus == exactly catalog ({' '.join(GOCENSUS_ALL)})",
        lsgc == " ".join(GOCENSUS_ALL), detail=f"got: {lsgc}")

s.phase("Phase 4: installs (download via curl -n + sha256 + extract)")
s.check_cmd(f"install golangci-lint@{GCL_V} (nested archive, strip=1)",
            ["mise", "install", f"golangci-lint@{GCL_V}"], env=home.env)
r = run(["mise", "exec", f"golangci-lint@{GCL_V}", "--", "golangci-lint", "version"], env=home.env)
s.check(f"golangci-lint runs and reports {GCL_V}", GCL_V in r.out, detail=r.tail())
s.check_cmd(f"install glab@{GLAB_V} (bin/ layout, strip=0)",
            ["mise", "install", f"glab@{GLAB_V}"], env=home.env)
r = run(["mise", "exec", f"glab@{GLAB_V}", "--", "glab", "--version"], env=home.env)
s.check(f"glab runs and reports {GLAB_V}", GLAB_V.lower() in r.out.lower(), detail=r.tail())
s.check_cmd(f"install go@{GO_V} (runtime distribution)",
            ["mise", "install", f"go@{GO_V}"], env=home.env)
r = run(["mise", "exec", f"go@{GO_V}", "--", "go", "version"], env=home.env)
gov = r.out.strip()
s.check(f"go runs: {gov}", f"go{GO_V}" in gov, detail=f"got: {gov}")
goroot_r = run(["mise", "exec", f"go@{GO_V}", "--", "sh", "-c", "echo $GOROOT"], env=home.env)
goroot_out = goroot_r.out.strip()
s.check(f"GOROOT exported and valid ({goroot_out})",
        bool(goroot_out) and Path(goroot_out, "src").is_dir(),
        detail=f"got: '{goroot_out}'")

s.phase(f"Phase 4b: go-installed tool (gocensus, via go install against {GOPROXY_HOST_URL})")
# a go tool needs an approved go toolchain already installed (bootstrapping
# go and a go tool together in one pass is not supported), but NOT on PATH:
# mise strips its own managed tool paths from PATH while hooks run, so the
# plugin locates the approved toolchain in mise's install tree itself —
# a plain "mise install" therefore has to work
gocensus_install = ["mise", "install", f"gocensus@{GOCENSUS_V}"]
s.check_cmd(f"install gocensus@{GOCENSUS_V} (go install, plugin-set GOPROXY, h1 verified)",
            gocensus_install, env=home.env)
r = run(["mise", "exec", f"gocensus@{GOCENSUS_V}", "--", "gocensus", "--help"], env=home.env)
s.check("gocensus runs (--help)", "gocensus <command>" in r.out or "Usage" in r.out,
        detail=r.tail())
r = run(["mise", "tool", "gocensus", "--backend"], env=home.env)
s.check("mise tool gocensus resolves to the vault backend", r.out.strip() == "vault:gocensus",
        detail=f"got: {r.out.strip()!r}; {r.tail()}")
r = run(["mise", "install", f"gocensus@9.9.9"], env=home.env)
s.check("unapproved gocensus version rejected",
        (not r.ok) and "not an approved version" in (r.out + r.err), detail=r.tail())
r = run(["mise", "install", "gocensus-bad-h1@0.2.0"], env=home.env)
combined = (r.out + r.err).lower()
s.check("go module checksum mismatch aborts install with explicit error",
        (not r.ok) and "checksum mismatch" in combined, detail=f"out: {(r.out + r.err)[:200]}")
# a binary that merely calls itself "go" must never be the one that builds:
# this shim reports an unapproved version and hard-fails any build attempt,
# so the install can only succeed by bypassing it for the approved toolchain
shim_dir = home.path / "fake-go-bin"
shim_dir.mkdir(parents=True, exist_ok=True)
shim = shim_dir / "go"
shim.write_text("#!/bin/sh\n"
                "if [ \"$1\" = version ]; then echo 'go version go9.9.9 linux/amd64'; exit 0; fi\n"
                "echo 'fake go shim was used for a build' >&2\n"
                "exit 1\n")
shim.chmod(0o755)
env_shim = {**home.env, "PATH": f"{shim_dir}:{home.env['PATH']}"}
r = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_shim)
s.check("unapproved go on PATH is bypassed for the approved toolchain (fake go9.9.9 shim)",
        r.ok, detail=r.tail())
# forged success markers in go's output must never flip a failure into a
# success: these shims claim an APPROVED version (so the toolchain gate
# accepts them), print a forged success trailer, then exit nonzero — the
# hook's real trailer is printed after theirs, so the forgery must lose
real_go = home.path / f".local/share/mise/installs/go/{GO_V}/bin/go"
forge_dir = home.path / "forge-go-bin"
forge_dir.mkdir(parents=True, exist_ok=True)
forge = forge_dir / "go"
forge.write_text("#!/bin/sh\n"
                 f"if [ \"$1\" = version ]; then echo 'go version go{GO_V} linux/amd64'; exit 0; fi\n"
                 f"if [ \"$1\" = mod ]; then exec '{real_go}' \"$@\"; fi\n"
                 "echo 'GOINSTALL_EXIT=0'\n"
                 "exit 7\n")
forge.chmod(0o755)
env_forge = {**home.env, "PATH": f"{forge_dir}:{home.env['PATH']}"}
r = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_forge)
s.check("forged GOINSTALL_EXIT=0 in build output cannot fake a successful install",
        (not r.ok) and "go install failed" in (r.out + r.err), detail=r.tail())
# the shim prints VALID JSON with the real catalogued Sum before the forged
# marker, so the only possible failure cause is trailer selection: a parser
# regressed to trusting the first forged marker would sail straight through
# to "go install failed" instead of "could not verify"
goc_h1 = next(rec["h1"] for rec in
              json.loads((REPO_ROOT / "catalog/gocensus/versions.json").read_text())
              if rec["version"] == GOCENSUS_V)
forge.write_text("#!/bin/sh\n"
                 f"if [ \"$1\" = version ]; then echo 'go version go{GO_V} linux/amd64'; exit 0; fi\n"
                 f"printf '{{\"Sum\":\"%s\"}}\\n' '{goc_h1}'\n"
                 "echo 'GOMOD_EXIT=0'\n"
                 "exit 9\n")
forge.chmod(0o755)
r = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_forge)
s.check("forged GOMOD_EXIT=0 with a correct Sum cannot fake checksum verification",
        (not r.ok) and "could not verify" in (r.out + r.err), detail=r.tail())

# a retained download directory (mise's always_keep_download) must not let
# a tampered module cache survive into the next install: the hook removes
# any previous cache contents, so poisoning the retained cache with a
# compile error and force-reinstalling has to succeed from fresh downloads
env_keep = {**home.env, "MISE_ALWAYS_KEEP_DOWNLOAD": "1"}
r = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_keep)
poisoned = 0
dl_cache = home.path / ".local/share/mise/downloads"
for src in dl_cache.glob(f"**/gomodcache/github.com/arloliu/gocensus@v{GOCENSUS_V}/**/*.go"):
    src.chmod(0o644)
    src.write_text("this is not go source\n")
    poisoned += 1
r2 = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_keep)
s.check("poisoned retained module cache is discarded, reinstall succeeds",
        r.ok and poisoned > 0 and r2.ok,
        detail=f"first={r.ok} poisoned_files={poisoned} second={r2.tail()}")

# and with NO approved toolchain anywhere, the install must fail by name
go_installs = home.path / ".local/share/mise/installs/go"
go_hidden = home.path / ".local/share/mise/installs/go.hidden"
shutil.move(str(go_installs), str(go_hidden))
try:
    r = run(["mise", "install", "-f", f"gocensus@{GOCENSUS_V}"], env=env_shim)
    s.check("no approved go toolchain anywhere aborts with explicit error",
            (not r.ok) and "no approved go toolchain" in (r.out + r.err), detail=r.tail())
finally:
    shutil.move(str(go_hidden), str(go_installs))

s.phase(f"Phase 4c: npm-installed tool (prettier, via npm through {NPM_PROXY_URL})")
install_r = s.check_cmd(
    f"install prettier@{PRETTIER_V} (npm runner, USER-ENV .npmrc registry)",
    ["mise", "install", f"prettier@{PRETTIER_V}"], env=home.env)
r = run(["mise", "exec", f"prettier@{PRETTIER_V}", "--", "prettier", "--version"], env=home.env)
s.check(f"prettier runs and reports {PRETTIER_V}", PRETTIER_V in r.out, detail=r.tail())
r = run(["mise", "tool", "prettier", "--backend"], env=home.env)
s.check("mise tool prettier resolves to the vault backend", r.out.strip() == "vault:prettier",
        detail=f"got: {r.out.strip()!r}; {r.tail()}")
# the install log prints the runner's effective registry where the runner
# can report it (npm config get registry); display only, never validated —
# task 1 flagged print() visibility from a mise plugin hook as unverified,
# so this checks the ACTUAL npm-proxy URL, not just the surrounding words
# (a silent fallback to the public registry would still contain "via npm
# (registry:", so the assertion has to name the real value to mean anything)
diag_text = install_r.out + install_r.err
diag_seen = "via npm (registry:" in diag_text and "127.0.0.2:8081/repository/npm-proxy" in diag_text
if diag_seen:
    s.ok("effective-registry diagnostic line shows the real npm-proxy URL in mise install output")
else:
    s.note("effective-registry diagnostic line NOT visible (or not showing the real npm-proxy URL) "
           f"in default 'mise install' output (checked stdout+stderr, {len(diag_text)} bytes); "
           "print() from a plugin hook is not surfaced by a normal install run", tag="INFO")

# prove the .npmrc file is what actually drove the install above, not some
# other channel (local npm cache, public-registry fallback, ...)
assert_registry_channel_drives_install("npm/.npmrc", "prettier", PRETTIER_V,
    env={"NPM_CONFIG_FETCH_RETRIES": "0", "NPM_CONFIG_FETCH_RETRY_MINTIMEOUT": "500"})

# the pinned noise-suppression env table must be set on every install;
# --verbose surfaces the constructed cmd.exec command line
r = run(["mise", "install", "-f", "--verbose", f"prettier@{PRETTIER_V}"], env=home.env)
verbose_out = r.out + r.err
s.check("npm noise-suppression pins present on every install (NPM_CONFIG_UPDATE_NOTIFIER/FUND/AUDIT)",
        r.ok and all(p in verbose_out for p in
                     ("NPM_CONFIG_UPDATE_NOTIFIER=false", "NPM_CONFIG_FUND=false", "NPM_CONFIG_AUDIT=false")),
        detail=r.tail())

# the npm install is placed at install_path via --prefix, so nothing lands
# outside mise's own managed-tool tree; derive install_path from HOME the
# same way the go smoke-install check above derives its own binary path
prettier_install_path = home.path / ".local/share/mise/installs/prettier" / PRETTIER_V
s.check(f"npm install pinned to install_path via --prefix ({prettier_install_path})",
        f"--prefix '{prettier_install_path}'" in verbose_out, detail=r.tail())

r = run(["mise", "install", f"prettier@9.9.9"], env=home.env)
s.check("unapproved prettier version rejected",
        (not r.ok) and "prettier 9.9.9 is not an approved version" in (r.out + r.err), detail=r.tail())

env_unknown_npm = {**home.env, "MISE_VAULT_NPM_RUNNER": "yarn"}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_unknown_npm)
combined = r.out + r.err
s.check("MISE_VAULT_NPM_RUNNER unknown value rejected, naming the expected values",
        (not r.ok) and "MISE_VAULT_NPM_RUNNER has an unknown value" in combined
        and "expected npm or bun" in combined, detail=r.tail())

# runner-missing: a PATH with every tool the hook needs EXCEPT npm itself
npm_missing_dir = path_without("npm", home.env["PATH"])
env_no_npm = {**home.env, "PATH": str(npm_missing_dir)}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_no_npm)
combined = r.out + r.err
s.check("npm missing from PATH aborts with the guidance message",
        (not r.ok) and "npm was not found on PATH" in combined
        and "install it and ensure it is on PATH" in combined, detail=r.tail())
shutil.rmtree(npm_missing_dir, ignore_errors=True)

# forged-trailer regression (NPMINSTALL_EXIT): a fake npm ahead on PATH
# prints a forged success marker mid-output, then exits nonzero; the REAL
# trailer is appended by the outer shell AFTER npm exits, so only an
# end-anchored parse of the true last line can tell these apart
forge_dir = home.path / "forge-npm-bin"
forge_dir.mkdir(parents=True, exist_ok=True)
forge_npm = forge_dir / "npm"
forge_npm.write_text("#!/bin/sh\necho 'NPMINSTALL_EXIT=0'\nexit 7\n")
forge_npm.chmod(0o755)
env_forge_npm = {**home.env, "PATH": f"{forge_dir}:{home.env['PATH']}"}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_forge_npm)
s.check("forged NPMINSTALL_EXIT=0 in npm output cannot fake a successful install",
        (not r.ok) and "npm install failed" in (r.out + r.err), detail=r.tail())

# bun runner (opt-in): same package, same USER-ENV .npmrc registry channel,
# placed via bun's own install-location variables instead of npm's --prefix
env_bun = bun_env()
s.check_cmd(f"install prettier@{PRETTIER_V} (bun runner — opt-in, USER-ENV .npmrc registry)",
            ["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_bun)
r = run(["mise", "exec", f"prettier@{PRETTIER_V}", "--", "prettier", "--version"], env=home.env)
s.check(f"prettier (bun) runs and reports {PRETTIER_V}", PRETTIER_V in r.out, detail=r.tail())
# bun has no equivalent of "npm config get registry" to report (it reads the
# environment's ~/.npmrc directly — verified on bun 1.3.14); the install log
# therefore prints no effective-registry value for this runner
s.note("bun runner prints no effective-registry line (documented: no npm-config-get "
       "equivalent to report through bun)", tag="INFO")

# prove .npmrc is what actually drove the bun install too — bun's manifest
# cache is keyed by registry host and revalidated, so a warm cache cannot
# satisfy the broken-registry leg
assert_registry_channel_drives_install("bun/.npmrc", "prettier", PRETTIER_V, env=env_bun)

r = run(["mise", "install", "-f", "--verbose", f"prettier@{PRETTIER_V}"], env=env_bun)
verbose_out = r.out + r.err
s.check("bun pin present on every install (DO_NOT_TRACK=1)",
        r.ok and "DO_NOT_TRACK=1" in verbose_out, detail=r.tail())
# bun's global-install tree, lockfile, and bin symlinks must all stay
# beneath install_path (the same guarantee --prefix proves for npm above)
s.check(f"bun placement pins point at install_path "
        f"(BUN_INSTALL_GLOBAL_DIR/BUN_INSTALL_BIN under {prettier_install_path})",
        r.ok and all(p in verbose_out for p in (
            f"BUN_INSTALL_GLOBAL_DIR='{prettier_install_path}'",
            f"BUN_INSTALL_BIN='{prettier_install_path}/bin'",
        )), detail=r.tail())

# runner-missing: a PATH with everything except bun itself
bun_missing_dir = path_without("bun", env_bun["PATH"])
env_no_bun = {**env_bun, "PATH": str(bun_missing_dir)}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_no_bun)
combined = r.out + r.err
s.check("bun missing from PATH aborts with the guidance message",
        (not r.ok) and "bun was not found on PATH" in combined
        and "install it and ensure it is on PATH" in combined, detail=r.tail())
shutil.rmtree(bun_missing_dir, ignore_errors=True)

# forged-trailer regression (BUNINSTALL_EXIT), same attack as the npm one
forge_bun_dir = home.path / "forge-bun-bin"
forge_bun_dir.mkdir(parents=True, exist_ok=True)
forge_bun = forge_bun_dir / "bun"
forge_bun.write_text("#!/bin/sh\necho 'BUNINSTALL_EXIT=0'\nexit 7\n")
forge_bun.chmod(0o755)
env_forge_bun = {**env_bun, "PATH": f"{forge_bun_dir}:{env_bun['PATH']}"}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_forge_bun)
s.check("forged BUNINSTALL_EXIT=0 in bun output cannot fake a successful install",
        (not r.ok) and "bun add failed" in (r.out + r.err), detail=r.tail())

# exact-invocation mutation check, the same oracle the cargo phase uses: a
# fake bun that records its full argv and BUN_*/DO_NOT_TRACK environment,
# one arg per line so quoting can never blur an argument boundary. The
# substring checks on --verbose output above cannot catch a reordered or
# renamed argument -- the words are all still present -- so this compares
# the complete argument list, order included. The shim never installs
# anything: it writes the expected binary stub itself and exits 0.
argv_bun_dir = home.path / "argv-bun-bin"
argv_bun_dir.mkdir(parents=True, exist_ok=True)
bun_argv_record = home.path / "bun-argv.record"
bun_env_record = home.path / "bun-env.record"
argv_bun = argv_bun_dir / "bun"
argv_bun.write_text(
    "#!/bin/sh\n"
    f"printf '%s\\n' \"$@\" > {shlex.quote(str(bun_argv_record))}\n"
    f"env | grep -E '^(BUN_[A-Za-z0-9_]*|DO_NOT_TRACK)=' > {shlex.quote(str(bun_env_record))} || true\n"
    "mkdir -p \"$BUN_INSTALL_BIN\"\n"
    "printf '#!/bin/sh\\necho fake-prettier-from-argv-shim\\n' > \"$BUN_INSTALL_BIN/prettier\"\n"
    "chmod +x \"$BUN_INSTALL_BIN/prettier\"\n"
    "exit 0\n")
argv_bun.chmod(0o755)
env_argv_bun = bun_env()
env_argv_bun["PATH"] = f"{argv_bun_dir}:{env_argv_bun['PATH']}"
baseline_bun_keys = {k for k in env_argv_bun
                     if k.startswith("BUN_") or k == "DO_NOT_TRACK"}
r = run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=env_argv_bun)
argv_lines = bun_argv_record.read_text().splitlines() if bun_argv_record.exists() else []
expected_argv = ["add", "-g", f"prettier@{PRETTIER_V}"]
s.check("bun shim: exact argv, full order (add, -g, package@version)",
        r.ok and argv_lines == expected_argv,
        detail=f"got argv={argv_lines!r}; expected={expected_argv!r}; {r.tail()}")
env_lines = bun_env_record.read_text().splitlines() if bun_env_record.exists() else []
recorded_env = dict(line.split("=", 1) for line in env_lines if "=" in line)
s.check("bun shim: placement and telemetry pins on the invocation "
        "(BUN_INSTALL_GLOBAL_DIR/BUN_INSTALL_BIN/DO_NOT_TRACK)",
        recorded_env.get("BUN_INSTALL_GLOBAL_DIR") == str(prettier_install_path)
        and recorded_env.get("BUN_INSTALL_BIN") == f"{prettier_install_path}/bin"
        and recorded_env.get("DO_NOT_TRACK") == "1",
        detail=f"recorded env: {recorded_env!r}")
extra_keys = (set(recorded_env) - baseline_bun_keys
              - {"BUN_INSTALL_GLOBAL_DIR", "BUN_INSTALL_BIN", "DO_NOT_TRACK"})
s.check("bun shim: no plugin-set BUN_*/DO_NOT_TRACK variable beyond the user's "
        "own environment and the required pins",
        not extra_keys,
        detail=f"unexpected extra vars: {sorted(extra_keys)}; recorded env: {recorded_env!r}")

# leave prettier cleanly installed via the default npm runner for any later
# phase that execs it
run(["mise", "install", "-f", f"prettier@{PRETTIER_V}"], env=home.env)

# scoped package (@scope/name) end-to-end: the registry metadata URL for a
# scoped name carries an encoded slash (@stoplight%2Fspectral-cli), a shape
# the plain prettier cases never exercise, so this proves the whole chain --
# catalog grammar, hook validation, proxy routing -- on a real scoped tool
# with both runners
s.check_cmd(f"install spectral@{SPECTRAL_V} (scoped npm package, npm runner)",
            ["mise", "install", f"spectral@{SPECTRAL_V}"], env=home.env)
r = run(["mise", "exec", f"spectral@{SPECTRAL_V}", "--", "spectral", "--version"], env=home.env)
s.check(f"spectral runs and reports {SPECTRAL_V}", SPECTRAL_V in r.out, detail=r.tail())
r = run(["mise", "tool", "spectral", "--backend"], env=home.env)
s.check("mise tool spectral resolves to the vault backend", r.out.strip() == "vault:spectral",
        detail=f"got: {r.out.strip()!r}; {r.tail()}")
s.check_cmd(f"install spectral@{SPECTRAL_V} (scoped npm package, bun runner)",
            ["mise", "install", "-f", f"spectral@{SPECTRAL_V}"], env=bun_env())
r = run(["mise", "exec", f"spectral@{SPECTRAL_V}", "--", "spectral", "--version"], env=home.env)
s.check(f"spectral (bun) runs and reports {SPECTRAL_V}", SPECTRAL_V in r.out, detail=r.tail())
r = run(["mise", "install", f"spectral@9.9.9"], env=home.env)
s.check("unapproved spectral version rejected",
        (not r.ok) and "spectral 9.9.9 is not an approved version" in (r.out + r.err), detail=r.tail())

s.phase(f"Phase 4d: pypi-installed tool (ruff, via pipx/uv through {PYPI_PROXY_SIMPLE_URL})")
s.check_cmd(f"install ruff@{RUFF_V} (pipx runner — default, USER-ENV pip.conf index-url)",
            ["mise", "install", f"ruff@{RUFF_V}"], env=home.env)
