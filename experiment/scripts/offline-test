#!/usr/bin/env python3
# Offline gate: the complete developer flow must work inside a network that can
# reach ONLY the private GitLab and Nexus — no route to the public internet.
# Runs offline-suite in a container attached solely to the compose 'isolated'
# network (internal: true), using the mise-vault-test image. The repository is
# mounted read-only so the suite and tests/lib come from the working tree.
#
# Nexus itself is also cut off from its upstream (the compose 'default'
# network) for the duration: the go-proxy repository is a caching proxy, and
# with egress available it would silently fetch any module the seed missed,
# making an incomplete seed look complete. With egress severed, only the
# already-cached content can be served — exactly the production situation.
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
NETWORK = "mise-vault-experiment_isolated"
EGRESS_NETWORK = "mise-vault-experiment_default"
NEXUS_CONTAINER = "mv-nexus"
IMAGE = "mise-vault-test"


def nexus_egress(connect):
    verb = "connect" if connect else "disconnect"
    cmd = ["docker", "network", verb]
    if connect:
        # A plain reconnect attaches the container with an EMPTY alias
        # list, silently dropping the "nexus" service alias compose
        # assigned — after which CI job containers on this network can no
        # longer resolve the http://nexus:8081 URLs their project
        # variables carry, and every pipeline fails with curl exit 6
        # until the stack is recreated (observed exactly that way).
        # Passing the aliases explicitly restores what compose set up.
        cmd += ["--alias", "nexus", "--alias", NEXUS_CONTAINER]
    cmd += [EGRESS_NETWORK, NEXUS_CONTAINER]
    r = subprocess.run(cmd, capture_output=True, text=True)
    # already connected / already disconnected is fine (a previous run may
    # have been interrupted); anything else is a real error
    if r.returncode != 0 and "is not connected" not in r.stderr \
            and "already exists in network" not in r.stderr:
        sys.exit(f"offline-test: could not {verb} nexus egress: {r.stderr.strip()}")


nexus_egress(connect=False)
try:
    rc = subprocess.call([
        "docker", "run", "--rm", "--network", NETWORK,
        "-v", f"{REPO_ROOT}:/repo:ro",
        IMAGE, "python3", "/repo/experiment/scripts/offline-suite",
    ])
finally:
    nexus_egress(connect=True)
sys.exit(rc)
