#!/usr/bin/env python3
# Runs INSIDE the offline container (see offline-test). The container's own
# HOME is used directly — the container is the isolation boundary here.
import os
import re
import shutil
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]   # /repo in the container
sys.path.insert(0, str(REPO_ROOT / "tests"))
from lib import catalog
from lib.env import (CONTAINER_MACHINES, GITLAB_CONTAINER_URL,
                     NEXUS_CONTAINER_URL, write_aliases, write_netrc)
from lib.harness import Suite, run

HOME = Path(os.environ["HOME"])
ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
s = Suite("offline-suite")
write_netrc(HOME, CONTAINER_MACHINES)


def safe_versions(tool, root):
    """A failed check must never abort the suite: if the bootstrap clone
    failed or its catalog is unreadable, fall back to an empty sentinel so
    the checks that depend on it simply fail in the normal way, and every
    later phase still runs through to the final summary."""
    try:
        return catalog.versions(tool, root)
    except (OSError, ValueError, KeyError, TypeError):
        return []


def safe_latest(tool, root):
    try:
        return catalog.latest(tool, root)
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        return ""


s.phase("0. the network really is offline")

r = run(["curl", "-m", "5", "-sf", "https://github.com", "-o", "/dev/null"], env=ENV)
if r.ok:
    s.bad("github.com reachable — network is NOT isolated")
else:
    s.ok("github.com unreachable")

r = run(["curl", "-m", "5", "-sf", "https://proxy.golang.org", "-o", "/dev/null"], env=ENV)
if r.ok:
    s.bad("proxy.golang.org reachable")
else:
    s.ok("proxy.golang.org unreachable")

r = run(["curl", "-m", "5", "-sf", f"{GITLAB_CONTAINER_URL}/users/sign_in", "-o", "/dev/null"], env=ENV)
if r.ok:
    s.ok("private GitLab reachable")
else:
    s.bad("private GitLab NOT reachable")

r = run(["curl", "-m", "5", "-sfn", f"{NEXUS_CONTAINER_URL}/service/rest/v1/status", "-o", "/dev/null"], env=ENV)
if r.ok:
    s.ok("private Nexus reachable")
else:
    s.bad("private Nexus NOT reachable")

s.phase("1. bootstrap from private GitLab only")

clone_r = run(["git", "clone", "-q", "--depth", "1",
               f"{GITLAB_CONTAINER_URL}/devtools/mise-vault.git", "/tmp/bootstrap"], env=ENV)
if clone_r.ok:
    install_r = run(["/tmp/bootstrap/install.sh"], env=ENV)
    bootstrap_ok = install_r.ok
    detail = install_r.tail()
else:
    bootstrap_ok = False
    detail = ""
if bootstrap_ok:
    s.ok("git clone + install.sh (netrc, offline network)")
else:
    s.bad(f"bootstrap failed: {detail}")

# The committed Nexus URL points at the host-side experiment address, which is
# not routable in this container. Use the sanctioned per-tool override channel.
aliases = {
    t: f"vault:{t}[nexus_url={NEXUS_CONTAINER_URL}/repository/devtools]"
    for t in ("go", "golangci-lint", "glab")
}
# a go-installed tool downloads modules, not artifacts, so its override is
# the go-proxy repository instead of the artifact repository
aliases["gocensus"] = f"vault:gocensus[goproxy_url={NEXUS_CONTAINER_URL}/repository/go-proxy]"
write_aliases(HOME, aliases)

s.phase("2. discovery and install with zero public internet")

# expected versions come from the catalog in the bootstrap clone, so approving
# a new version never requires editing this suite
GCL_ALL = " ".join(safe_versions("golangci-lint", "/tmp/bootstrap"))
GLAB_V = safe_latest("glab", "/tmp/bootstrap")
GO_V = safe_latest("go", "/tmp/bootstrap")

r = run(["mise", "ls-remote", "golangci-lint"], env=ENV)
LSR = " ".join(r.out.split())
if GCL_ALL and LSR == GCL_ALL:
    s.ok("ls-remote == catalog")
else:
    s.bad(f"ls-remote (got: {LSR[:80]})")

install_r = run(["mise", "install", f"glab@{GLAB_V}"], env=ENV)
if install_r.ok:
    exec_r = run(["mise", "exec", f"glab@{GLAB_V}", "--", "glab", "--version"], env=ENV)
    glab_ok = bool(GLAB_V) and exec_r.ok and GLAB_V.lower() in exec_r.out.lower()
else:
    glab_ok = False
if glab_ok:
    s.ok("glab installed and runs (download from private Nexus, sha verified)")
else:
    s.bad("glab install")

install_r = run(["mise", "install", f"go@{GO_V}"], env=ENV)
if install_r.ok:
    exec_r = run(["mise", "exec", f"go@{GO_V}", "--", "go", "version"], env=ENV)
    go_ok = bool(GO_V) and exec_r.ok and f"go{GO_V}" in exec_r.out
else:
    go_ok = False
if go_ok:
    s.ok("go runtime installed and runs")
else:
    s.bad("go install")

# gocensus is built from source with "go install" served entirely by the
# go-proxy cache, which proves the seeded cache holds the FULL dependency
# closure — any module missing from it fails this install right here.
# No PATH setup: this container has no system go, so the plugin must find
# the just-installed approved toolchain in mise's install tree by itself.
GOC_V = safe_latest("gocensus", "/tmp/bootstrap")
install_r = run(["mise", "install", f"gocensus@{GOC_V}"], env=ENV)
if install_r.ok:
    exec_r = run(["mise", "exec", f"gocensus@{GOC_V}", "--", "gocensus", "--help"], env=ENV)
    goc_ok = bool(GOC_V) and exec_r.ok
else:
    goc_ok = False
if goc_ok:
    s.ok("gocensus built via go install (full module closure from private go-proxy)")
else:
    s.bad(f"gocensus install ({install_r.tail()})")

s.phase("2b. npm and pypi tool types (both pypi runners) with zero public internet")

# There is deliberately no MISE_VAULT_*_REGISTRY channel for these types
# (design doc section 5): the plugin never touches registry configuration,
# so — exactly like a real workstation — this container's own USER-ENV
# files point ecosystem installers at the private Nexus proxy repositories.
# All plain http, mirroring the production shapes.
NPM_PROXY_URL = f"{NEXUS_CONTAINER_URL}/repository/npm-proxy/"
PYPI_PROXY_SIMPLE_URL = f"{NEXUS_CONTAINER_URL}/repository/pypi-proxy/simple"
NEXUS_HOST = NEXUS_CONTAINER_URL.split("//", 1)[1].split("/", 1)[0]  # "nexus:8081"
NEXUS_HOSTNAME = NEXUS_HOST.split(":", 1)[0]                        # "nexus"

(HOME / ".npmrc").write_text(f"registry={NPM_PROXY_URL}\n")
pip_dir = HOME / ".config/pip"
pip_dir.mkdir(parents=True, exist_ok=True)
(pip_dir / "pip.conf").write_text(
    "[global]\n"
    f"index-url = {PYPI_PROXY_SIMPLE_URL}\n"
    f"trusted-host = {NEXUS_HOSTNAME}\n")
# uv reads only user-level (~/.config/uv/uv.toml) and system-level config
# for "uv tool" commands, never a project-local uv.toml.
uv_dir = HOME / ".config/uv"
uv_dir.mkdir(parents=True, exist_ok=True)
(uv_dir / "uv.toml").write_text(
    f'index-url = "{PYPI_PROXY_SIMPLE_URL}"\n'
    f'allow-insecure-host = ["{NEXUS_HOST}"]\n')

aliases["prettier"] = "vault:prettier"
aliases["ruff"] = "vault:ruff"
write_aliases(HOME, aliases)

PRETTIER_V = safe_latest("prettier", "/tmp/bootstrap")
RUFF_V = safe_latest("ruff", "/tmp/bootstrap")

install_r = run(["mise", "install", f"prettier@{PRETTIER_V}"], env=ENV)
if install_r.ok:
    exec_r = run(["mise", "exec", f"prettier@{PRETTIER_V}", "--", "prettier", "--version"], env=ENV)
    prettier_ok = bool(PRETTIER_V) and exec_r.ok and PRETTIER_V in exec_r.out
else:
    prettier_ok = False
if prettier_ok:
    s.ok("prettier installed via npm and runs (package document + tarball from private npm-proxy)")
else:
    s.bad(f"prettier install ({install_r.tail()})")

install_r = run(["mise", "install", f"ruff@{RUFF_V}"], env=ENV)
if install_r.ok:
    exec_r = run(["mise", "exec", f"ruff@{RUFF_V}", "--", "ruff", "--version"], env=ENV)
    ruff_pipx_ok = bool(RUFF_V) and exec_r.ok and RUFF_V in exec_r.out
else:
    ruff_pipx_ok = False
if ruff_pipx_ok:
    s.ok("ruff installed via pipx (default runner) and runs (simple-API page + wheel from private pypi-proxy)")
else:
    s.bad(f"ruff install via pipx ({install_r.tail()})")

install_r = run(["mise", "install", "-f", f"ruff@{RUFF_V}"], env={**ENV, "MISE_VAULT_PYPI_RUNNER": "uv"})
if install_r.ok:
    exec_r = run(["mise", "exec", f"ruff@{RUFF_V}", "--", "ruff", "--version"], env=ENV)
    ruff_uv_ok = bool(RUFF_V) and exec_r.ok and RUFF_V in exec_r.out
else:
    ruff_uv_ok = False
if ruff_uv_ok:
    s.ok("ruff installed via uv (opt-in runner, USER-ENV uv.toml) and runs, offline")
else:
    s.bad(f"ruff install via uv ({install_r.tail()})")

s.phase("2c. cargo tool type with zero public internet")

# Same reasoning as 2b: no MISE_VAULT_*_REGISTRY channel for cargo either,
# so this container's own USER-ENV ~/.cargo/config.toml source-replaces
# crates-io with the private Nexus cargo proxy — this repository format is
# unconditionally supported (confirmed against this experiment's Nexus CE
# build), so unlike an earlier draft of this design there is no online-only
# fallback to carry here.
CARGO_PROXY_HOST_URL = f"{NEXUS_CONTAINER_URL}/repository/cargo-proxy"
cargo_dir = HOME / ".cargo"
cargo_dir.mkdir(parents=True, exist_ok=True)
(cargo_dir / "config.toml").write_text(
    '[source.crates-io]\n'
    'replace-with = "nexus-cargo"\n'
    '\n'
    '[registries.nexus-cargo]\n'
    f'index = "sparse+{CARGO_PROXY_HOST_URL}/"\n')

aliases["tokei"] = "vault:tokei"
write_aliases(HOME, aliases)

TOKEI_V = safe_latest("tokei", "/tmp/bootstrap")

# cargo compiles from source every run (this container's CARGO_HOME never
# persists a build cache across runs), so this gets a longer timeout than
# the default 120s the way the poc-test suite's cargo checks do.
install_r = run(["mise", "install", f"tokei@{TOKEI_V}"], env=ENV, timeout=300)
if install_r.ok:
    exec_r = run(["mise", "exec", f"tokei@{TOKEI_V}", "--", "tokei", "--version"], env=ENV)
    tokei_ok = bool(TOKEI_V) and exec_r.ok and TOKEI_V in exec_r.out
else:
    tokei_ok = False
if tokei_ok:
    s.ok("tokei built via cargo (full dependency closure from private cargo-proxy)")
else:
    s.bad(f"tokei install ({install_r.tail()})")

s.phase("3. catalog-only policy holds offline")

# assert the EFFECT (command fails, no versions listed), not mise's wording
r = run(["mise", "ls-remote", "jq"], env=ENV, timeout=30)
jq_out = r.out + "\n" + r.err
if not r.ok and not re.search(r'^[0-9]+\.', jq_out, re.MULTILINE):
    s.ok("uncataloged tool blocked")
else:
    s.bad(f"jq not blocked (exit={r.rc}; {jq_out[:100]})")

s.phase("4. MISE_OFFLINE=1 behavior (documenting, not gating)")

r = run(["mise", "ls-remote", "glab"], env={**ENV, "MISE_OFFLINE": "1"})
if GLAB_V and any(line == GLAB_V for line in r.out.splitlines()):
    s.ok("MISE_OFFLINE=1: ls-remote still serves the local catalog")
else:
    s.bad("MISE_OFFLINE=1 broke catalog listing")

GCL_V = safe_latest("golangci-lint", "/tmp/bootstrap")
shutil.rmtree(HOME / ".local/share/mise/installs/golangci-lint", ignore_errors=True)
r = run(["mise", "install", f"golangci-lint@{GCL_V}"], env={**ENV, "MISE_OFFLINE": "1"})
if r.ok:
    s.note("MISE_OFFLINE=1 does NOT block the plugin's own download (curl via cmd)")
else:
    s.note("MISE_OFFLINE=1 blocks backend-plugin installs")

sys.exit(s.finish())
