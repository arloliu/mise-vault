#!/usr/bin/env python3
# End-to-end bootstrap test: the full new-developer flow
# in a fresh isolated HOME, driven only by git clone + ~/.netrc.
#
# The MAIN flow (phases 1-5) bootstraps from the experiment GitLab's default
# branch, which must equal the local HEAD — so every assertion about machine
# state is made against the code under review, never against an older tag.
# Phase 6 separately proves that a tag-pinned bootstrap works, in its own HOME.
import os
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT / "tests"))
from lib import catalog
from lib.env import GITLAB_HOST_URL, GITLAB_DEV_TOKEN, IsolatedHome
from lib.harness import Suite, run

PIN_REF = os.environ.get("EXPERIMENT_PIN_TAG", "v0.0.14")  # pin/re-pin coverage only
s = Suite("bootstrap-test")
home = IsolatedHome("mise-vault-bootstrap.", write_settings=False)

s.phase("1. documented bootstrap from the default branch (the code under review)")

local_head_r = run(["git", "-C", str(REPO_ROOT), "rev-parse", "HEAD"])
LOCAL_HEAD = local_head_r.out.strip() if local_head_r.ok else "unknown"
# expected versions come from the catalog, so approving a new version never
# requires editing this suite
GCL_ALL = " ".join(catalog.versions("golangci-lint", REPO_ROOT))
GLAB_V = catalog.latest("glab", REPO_ROOT)

clone_dir = home.path / "bootstrap"
r = run(["git", "clone", "-q", "--depth", "1",
         f"{GITLAB_HOST_URL}/devtools/mise-vault.git", str(clone_dir)], env=home.env)
s.check("git clone (default branch) via netrc", r.ok, detail=r.tail())

cloned_r = run(["git", "-C", str(clone_dir), "rev-parse", "HEAD"], env=home.env)
CLONED = cloned_r.out.strip() if cloned_r.ok else "none"
# everything below only vouches for the code under review if this holds
s.check(f"experiment GitLab default branch == local HEAD ({LOCAL_HEAD[:12]})",
        CLONED == LOCAL_HEAD,
        detail=(f"experiment GitLab is NOT serving the local HEAD "
                f"(cloned {CLONED[:12]}, local {LOCAL_HEAD[:12]}) — "
                f"push to the experiment remote and re-run"))

expect_r = run(["git", "-C", str(clone_dir), "describe", "--tags", "--exact-match"], env=home.env)
EXPECT = expect_r.out.strip() if expect_r.ok and expect_r.out.strip() else CLONED

r = run([str(clone_dir / "install.sh")], env=home.env)
s.check("./install.sh (branch checkout installs the exact cloned commit)", r.ok,
        detail=f"install.sh failed (log: {r.tail()})")

install1_out = r.out + r.err
version_lines = [l for l in install1_out.splitlines() if "version" in l.lower()]
s.check(f"installer self-detected the cloned commit ({EXPECT[:12]})",
        f"version {EXPECT}" in install1_out,
        detail=f"commit self-detection (log: {version_lines[0][:120] if version_lines else ''})")

# token-based alternative fetch must also serve the script intact
r = run(["curl", "-fsSL", "-H", f"PRIVATE-TOKEN: {GITLAB_DEV_TOKEN}",
         f"{GITLAB_HOST_URL}/api/v4/projects/devtools%2Fmise-vault/repository/files/"
         f"install.sh/raw?ref={CLONED}"], env=home.env)
first_line = r.out.splitlines()[0] if r.out else ""
s.check("API+PRIVATE-TOKEN raw fetch returns the script", first_line == "#!/usr/bin/env bash",
        detail="API raw fetch alternative")

s.phase("2. resulting machine state")

r = run(["mise", "settings", "gix"], env=home.env)
s.check("settings gix=false written", "false" in r.out, detail="gix setting")
# both must be false — either one being true selects mise's built-in git,
# which ignores netrc and credential helpers
r = run(["mise", "settings", "libgit2"], env=home.env)
s.check("settings libgit2=false written", "false" in r.out, detail="libgit2 setting")

r = run(["mise", "settings", "disable_default_registry"], env=home.env)
s.check("settings disable_default_registry=true written", "true" in r.out,
        detail="disable_default_registry setting")

DB = run(["mise", "settings", "disable_backends"], env=home.env).out
s.check("disable_backends covers the public backends (core, aqua, ...)",
        "core" in DB and "aqua" in DB,
        detail=f"disable_backends incomplete (got: {' '.join(DB.split())[:120]})")

conf_path = home.path / ".config/mise/conf.d/mise-vault.toml"
conf_text = conf_path.read_text() if conf_path.exists() else ""
s.check("conf.d/mise-vault.toml generated", "GENERATED by mise-vault" in conf_text,
        detail="conf.d file")
s.check("aliases are pure routing (no embedded URL)",
        "glab = 'vault:glab'" in conf_text.splitlines(), detail="alias shape")

s.phase("3. developer experience")

r = run(["mise", "ls-remote", "golangci-lint"], env=home.env)
LSR = " ".join(r.out.split())
s.check("mise ls-remote golangci-lint == catalog", LSR == GCL_ALL,
        detail=f"ls-remote (got: {LSR})")

proj = home.path / "app"
proj.mkdir(parents=True, exist_ok=True)
(proj / "mise.toml").write_text(f'[tools]\nglab = "{GLAB_V}"\n')
run(["mise", "trust", "-q"], cwd=str(proj), env=home.env)
r_install = run(["mise", "install"], cwd=str(proj), env=home.env)
if r_install.ok:
    r_exec = run(["mise", "exec", "--", "glab", "--version"], cwd=str(proj), env=home.env)
    project_flow_ok = r_exec.ok and GLAB_V.lower() in r_exec.out.lower()
else:
    project_flow_ok = False
s.check("project mise.toml -> mise install -> glab runs", project_flow_ok,
        detail="project install flow")

# guard against the public-registry fallback false positive: backend must be ours
r = run(["mise", "tool", "glab"], cwd=str(proj), env=home.env)
backend_lines = [l for l in r.out.splitlines() if "backend" in l.lower()]
s.check("glab resolved through vault backend (not public registry)",
        "vault:glab" in r.out,
        detail=f"glab backend is NOT vault ({backend_lines[0] if backend_lines else ''})")

# catalog-only policy: uncataloged names and explicit public backends must fail
# assert the EFFECT (command fails, no versions listed), not mise's exact
# error wording, which has changed across releases
r = run(["mise", "ls-remote", "jq"], env=home.env, timeout=30)
jq_out = r.out + "\n" + r.err
s.check("uncataloged tool (jq) blocked — no public registry reach",
        not r.ok and not re.search(r'^[0-9]+\.', jq_out, re.MULTILINE),
        detail=f"jq was not blocked (exit={r.rc}; {jq_out[:100]})")

r = run(["mise", "install", "aqua:jqlang/jq@1.7.1"], env=home.env, timeout=30)
aq_out = r.out + "\n" + r.err
s.check("explicit public backend spec refused",
        not r.ok and "disabled" in aq_out.lower(),
        detail=f"aqua: spec was not refused (exit={r.rc}; {aq_out[:100]})")

s.phase("4. idempotency: run the bootstrap again")

r = run([str(clone_dir / "install.sh")], env=home.env)
s.check("second bootstrap run exits 0", r.ok, detail=f"second run (log: {r.tail()})")

r = run(["mise", "ls-remote", "glab"], env=home.env)
s.check("still functional after re-run", GLAB_V in r.out.splitlines(), detail="post re-run state")

s.phase("5. vault-sync task (pin to a tag, then back to latest)")

if conf_path.exists():
    conf_path.unlink()
vault_sync = home.path / ".local/share/mise/plugins/vault/scripts/vault-sync"
r = run([str(vault_sync)], env=home.env)
conf_text = conf_path.read_text() if conf_path.exists() else ""
s.check("direct vault-sync regenerates deleted conf.d",
        r.ok and "tool_alias" in conf_text, detail="direct vault-sync")

r = run(["mise", "run", "vault-sync"], cwd=str(home.path), env=home.env)
s.check("'mise run vault-sync' works as a global task", r.ok,
        detail="mise run vault-sync (global task)")

r = run(["mise", "run", "vault-sync", PIN_REF], cwd=str(home.path), env=home.env)
sync_ref_out = r.out + r.err
s.check("'mise run vault-sync <ref>' re-pins plugin then regenerates",
        r.ok and f"updating plugin to {PIN_REF}" in sync_ref_out,
        detail=f"vault-sync with ref (log: {sync_ref_out[-200:]})")

r = run(["mise", "run", "vault-sync", "latest"], cwd=str(home.path), env=home.env)
sync_latest_out = r.out + r.err
if r.ok and "updating plugin to latest" in sync_latest_out:
    lsr_after = run(["mise", "ls-remote", "glab"], env=home.env)
    latest_ok = GLAB_V in lsr_after.out.splitlines()
else:
    latest_ok = False
s.check("'mise run vault-sync latest' updates to default-branch HEAD", latest_ok,
        detail=f"vault-sync latest (log: {sync_latest_out[-200:]})")

s.phase("6. tag-pinned bootstrap works too (separate HOME)")

tag_home = IsolatedHome("mise-vault-bootstrap-tag.", write_settings=False)
r = run(["git", "-c", "advice.detachedHead=false", "clone", "-q", "--depth", "1",
         "-b", PIN_REF, f"{GITLAB_HOST_URL}/devtools/mise-vault.git",
         str(tag_home.path / "bootstrap")], env=tag_home.env)
if not r.ok:
    s.bad("tag clone failed", r.tail())
else:
    r = run([str(tag_home.path / "bootstrap/install.sh")], env=tag_home.env)
    if not r.ok:
        s.bad("tagged install.sh failed", r.tail())
    elif PIN_REF not in r.out + r.err:
        s.bad("tag self-detection missing from install log")
    elif not run(["mise", "ls-remote", "glab"], env=tag_home.env).out.strip():
        s.bad("tagged bootstrap not functional")
    else:
        s.ok(f"tagged checkout ({PIN_REF}) bootstraps, self-detects the tag, and serves the catalog")
tag_home.remove()

sys.exit(s.finish(keep_on_failure=[home]))
