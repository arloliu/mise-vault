{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.company.example/devtools/mise-vault/schemas/tool.schema.json",
  "title": "mise-vault tool definition (catalog/<tool>/tool.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "platforms"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Tool name; must equal the catalog directory name"
    },
    "type": {
      "enum": ["archive", "binary", "runtime"],
      "description": "Installation class: plain archive, single binary, or full runtime distribution"
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(linux|darwin|windows)-(amd64|arm64)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "format"],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]*\\{version\\}[A-Za-z0-9._+-]*$",
              "description": "Artifact file name template; only {version} is substituted — each platform spells out its own full name, nothing is inferred from os/arch. Must be a plain file name: no path separators or shell metacharacters"
            },
            "format": { "enum": ["tar.gz", "tar.xz", "tar.bz2", "zip", "binary"] },
            "strip_components": { "type": "integer", "minimum": 0, "maximum": 3 },
            "bin_paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._+/-]+$",
                "description": "Relative path inside the install directory; never absolute, never containing '..'"
              }
            }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Extra env vars for BackendExecEnv; {install_path}/{version} substituted"
    }
  }
}
